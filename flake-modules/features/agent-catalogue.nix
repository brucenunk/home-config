{ config, inputs, ... }:

let
  machineData = config.flake.lib.machines;
  # Quote every string; only the fixed setq form below is executable syntax.
  plistContents =
    value:
    builtins.concatStringsSep " " (
      map (key: ":${key} ${toLisp value.${key}}") (builtins.attrNames value)
    );
  toLisp =
    value:
    if builtins.isString value then
      "\"${
        builtins.replaceStrings [ "\\" "\"" "\n" "\r" "\t" ] [ "\\\\" "\\\"" "\\n" "\\r" "\\t" ] value
      }\""
    else if builtins.isList value then
      "(${builtins.concatStringsSep " " (map toLisp value)})"
    else if builtins.isAttrs value then
      "(${plistContents value})"
    else
      throw "Unsupported agent catalogue value";
  catalogue =
    machines:
    "(${
      builtins.concatStringsSep " " (
        builtins.map (
          name:
          let
            machine = machines.${name};
          in
          "(${toLisp name} ${
            plistContents {
              inherit (machine) directory;
              repositories = builtins.map (slug: {
                name = slug;
                inherit (machine.repositories.${slug}) path;
                base-ref = "origin/${machine.repositories.${slug}.defaultBranch}";
              }) (builtins.attrNames machine.repositories);
              default-model = machineData.defaultModel machine;
              models = map (model: {
                inherit (model) name;
                thinking-levels = model.thinkingLevels;
                default-thinking = model.defaultThinking;
              }) (machineData.projectModels machine);
            }
          })"
        ) (builtins.attrNames machines)
      )
    })";
  homeManagerModule = { config, ... }: {
    imports = [ machinesModule ];
    xdg.configFile."emacs/agent-catalogue.el".text =
      ";; Generated by Nix. -*- lexical-binding: t -*-\n"
      + ";; Trusted executable Emacs configuration.\n"
      + "(setq my/agent-machines\n      '${catalogue config.brucenunk.homeManager.machines})\n";
  };
  machinesModule = config.flake.modules.homeManager.machines;
in
{
  flake.modules.homeManager.agent-catalogue = homeManagerModule;

  perSystem =
    { pkgs, ... }:
    let
      home = inputs.home-manager.lib.homeManagerConfiguration {
        inherit pkgs;
        modules = [
          homeManagerModule
          {
            home.username = "agent-catalogue-check";
            home.homeDirectory =
              if pkgs.stdenv.hostPlatform.isDarwin then
                "/Users/agent-catalogue-check"
              else
                "/home/agent-catalogue-check";
            home.stateVersion = "25.05";
            brucenunk.homeManager.machines = {
              machine-a = {
                isLocal = true;
                repositories."example/project".path = "/work/quoted \"path\"/back\\slash/é/main";
                models.providers.example = {
                  apiKey = "private-credential";
                  baseUrl = "https://private-endpoint.invalid";
                  models = [
                    {
                      id = "vendor/model";
                      reasoning = true;
                    }
                  ];
                };
              };
              machine-b = {
                directory = "/rpc:remote.example:~/work/";
                repositories."example/bare" = {
                  path = "/srv/git/project.git";
                  defaultBranch = "master";
                };
              };
            };
          }
        ];
      };
      emacs = pkgs.emacs.pkgs.emacsWithPackages (epkgs: [
        epkgs.denote
        epkgs.vertico
      ]);
      defaultModels =
        pkgs.lib.recursiveUpdate home.config.brucenunk.homeManager.machines.machine-a.models
          {
            providers.example.models = [
              {
                id = "vendor/model";
                reasoning = true;
              }
              {
                id = "alternate";
                reasoning = false;
              }
            ];
          };
      piDefaultHome = home.extendModules {
        modules = [
          config.flake.modules.homeManager.pi
          {
            brucenunk.homeManager.pi = {
              enable = false;
              models = defaultModels;
              settingsDefaults = builtins.toFile "agent-catalogue-pi-defaults.json" (
                builtins.toJSON {
                  defaultProvider = "example";
                  defaultModel = "alternate";
                }
              );
            };
            brucenunk.homeManager.machines.machine-a.models = pkgs.lib.mkForce defaultModels;
          }
        ];
      };
      clearedDefaultHome = piDefaultHome.extendModules {
        modules = [ { brucenunk.homeManager.machines.machine-a.defaultModel = null; } ];
      };
      explicitDefaultHome = piDefaultHome.extendModules {
        modules = [ { brucenunk.homeManager.machines.machine-a.defaultModel = "example/vendor/model"; } ];
      };
      rejects =
        module:
        !(builtins.tryEval (home.extendModules { modules = [ module ]; }).activationPackage.drvPath)
        .success;
      longHint = builtins.concatStringsSep "" (pkgs.lib.replicate 4097 "a");
    in
    {
      checks.agent-catalogue-home-manager-module =
        assert
          piDefaultHome.config.brucenunk.homeManager.machines.machine-a.defaultModel == "example/alternate";
        assert
          machineData.defaultModel piDefaultHome.config.brucenunk.homeManager.machines.machine-a
          == "example/alternate";
        assert piDefaultHome.config.brucenunk.homeManager.machines.machine-b.defaultModel == null;
        assert
          machineData.defaultModel clearedDefaultHome.config.brucenunk.homeManager.machines.machine-a
          == "example/vendor/model";
        assert
          machineData.defaultModel explicitDefaultHome.config.brucenunk.homeManager.machines.machine-a
          == "example/vendor/model";
        assert rejects { brucenunk.homeManager.machines.machine-a.isLocal = pkgs.lib.mkForce false; };
        assert rejects { brucenunk.homeManager.machines.machine-b.isLocal = true; };
        assert rejects { brucenunk.homeManager.machines.machine-b.directory = pkgs.lib.mkForce ""; };
        assert rejects {
          brucenunk.homeManager.machines.machine-b.directory = pkgs.lib.mkForce "relative/work";
        };
        assert rejects {
          brucenunk.homeManager.machines.machine-b.directory = pkgs.lib.mkForce "~/work/\n";
        };
        assert rejects {
          brucenunk.homeManager.machines.machine-b.repositories."example/bare".path =
            pkgs.lib.mkForce "relative/repo";
        };
        assert rejects {
          brucenunk.homeManager.machines.machine-b.repositories."example/bare".path =
            pkgs.lib.mkForce "/rpc:remote.example:/srv/repo.git";
        };
        assert rejects {
          brucenunk.homeManager.machines.machine-b.repositories."invalid".path = "/srv/invalid.git";
        };
        assert rejects { brucenunk.homeManager.machines.machine-b.defaultModel = "example/unknown"; };
        assert rejects {
          brucenunk.homeManager.machines.${longHint}.directory = "/rpc:remote.example:~/work/";
        };
        assert rejects {
          brucenunk.homeManager.machines.machine-b.repositories."owner/${longHint}".path = "/srv/long.git";
        };
        assert rejects {
          brucenunk.homeManager.machines.machine-b.models.providers.example.models = [
            { id = "bad\nmodel"; }
          ];
        };
        assert rejects {
          brucenunk.homeManager.machines.machine-b.models.providers.example.models = [
            { id = "bad model"; }
          ];
        };
        assert rejects {
          brucenunk.homeManager.machines.machine-b.models.providers.example.models = [
            { id = "duplicate"; }
            { id = "DUPLICATE"; }
          ];
        };
        assert rejects {
          brucenunk.homeManager.machines.machine-b.models.providers = {
            Example.models = [ { id = "one"; } ];
            example.models = [ { id = "two"; } ];
          };
        };
        assert rejects {
          brucenunk.homeManager.machines.machine-b.models.providers.example.models = [
            { id = longHint; }
          ];
        };
        builtins.deepSeq home.activationPackage.drvPath (
          pkgs.runCommand "agent-catalogue-home-manager-module"
            {
              nativeBuildInputs = [ emacs ];
            }
            ''
              export HOME="$TMPDIR"
              export AGENT_CATALOGUE_TEST=${home.config.xdg.configFile."emacs/agent-catalogue.el".source}
              emacs --batch -Q -L ${../../config/emacs/my-lisp} \
                -l my-agent-catalogue-tests -l my-task-tests -l my-task-list-tests \
                -f ert-run-tests-batch-and-exit
              touch "$out"
            ''
        );
    };
}
