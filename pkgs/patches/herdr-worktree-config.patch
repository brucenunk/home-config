 fn git_dir_is_bare(git_dir: &Path) -> bool {
-    read_git_config_value(&git_dir.join("config"), "core", "bare")
-        .is_some_and(|value| value.eq_ignore_ascii_case("true"))
+    let common_config = git_common_dir_for_git_dir(git_dir).join("config");
+    let worktree_config_enabled =
+        read_git_config_value(&common_config, "extensions", "worktreeConfig")
+            .is_some_and(|value| git_config_bool_is_true(&value));
+    let bare = if worktree_config_enabled {
+        read_git_config_value(&git_dir.join("config.worktree"), "core", "bare")
+            .or_else(|| read_git_config_value(&common_config, "core", "bare"))
+    } else {
+        // Without worktreeConfig, Git ignores shared core.bare for linked
+        // checkouts. Preserve their existing non-bare discovery behavior.
+        read_git_config_value(&git_dir.join("config"), "core", "bare")
+    };
+    bare.is_some_and(|value| git_config_bool_is_true(&value))
+}
+
+fn git_config_bool_is_true(value: &str) -> bool {
+    matches!(
+        value.to_ascii_lowercase().as_str(),
+        "true" | "yes" | "on" | "1"
+    )
 }

