+    #[test]
+    fn git_bare_worktree_config_precedence() {
+        let root = temp_test_dir("bare-config-precedence");
+        for (extension, shared, specific, expected) in [
+            ("true", "false", "true", true),
+            ("true", "true", "false", false),
+            ("true", "true", "", true),
+            ("true", "", "true", true),
+            ("false", "false", "true", false),
+            ("false", "true", "false", true),
+            ("1", "", "true", true),
+            ("yes", "false", "on", true),
+            ("ON", "false", "YES", true),
+            ("true", "1", "0", false),
+            ("off", "false", "true", false),
+            ("no", "false", "true", false),
+            ("0", "false", "true", false),
+        ] {
+            std::fs::write(
+                root.join("config"),
+                format!(
+                    "[extensions]\nworktreeConfig = {extension}\n[core]\n{}",
+                    if shared.is_empty() {
+                        String::new()
+                    } else {
+                        format!("bare = {shared}\n")
+                    }
+                ),
+            )
+            .unwrap();
+            std::fs::write(
+                root.join("config.worktree"),
+                format!(
+                    "[core]\n{}",
+                    if specific.is_empty() {
