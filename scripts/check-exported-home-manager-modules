#!/usr/bin/env sh
set -eu

repo_root=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
cd "$repo_root"

# Evaluate every module supported by the invoking platform with plain nixpkgs
# and no consumer overlays or extraSpecialArgs. Feature-specific behavior is
# covered by the flake checks defined beside each owning module.
# shellcheck disable=SC2016 # The single-quoted value is a Nix expression.
nix eval --impure --raw --expr '
  let
    flake = builtins.getFlake (toString ./.);
    pkgs = import flake.inputs.nixpkgs {
      system = builtins.currentSystem;
      config.allowUnfree = true;
    };
    lib = pkgs.lib;

    identity = {
      home.username = "exported-module-check";
      home.homeDirectory =
        if pkgs.stdenv.hostPlatform.isDarwin then
          "/Users/exported-module-check"
        else
          "/home/exported-module-check";
      home.stateVersion = "25.05";
    };

    mkHome = module: flake.inputs.home-manager.lib.homeManagerConfiguration {
      inherit pkgs;
      modules = [ module identity ];
    };

    expectedModuleNames = [
      "agents"
      "bazel"
      "darkman"
      "direnv"
      "doric-waybar-themes"
      "emacs"
      "fd"
      "firmware-update-notifier"
      "fish"
      "fonts"
      "fzf"
      "ghostty"
      "git"
      "git-maintenance"
      "golang"
      "hephaestus"
      "herdr"
      "kube"
      "language-servers"
      "niri"
      "ollama"
      "packages"
      "pi"
      "python"
      "ripgrep"
      "rust"
      "waybar"
    ];
    linuxOnlyModuleNames = [
      "darkman"
      "niri"
      "waybar"
    ];
    exportedModules = flake.modules.homeManager;
    nativeModules =
      if pkgs.stdenv.hostPlatform.isLinux then
        exportedModules
      else
        builtins.removeAttrs exportedModules linuxOnlyModuleNames;

    optionNames = home: map (option: option.name) (lib.optionAttrSetToDocList home.options);
    baselineOptionNames = optionNames (flake.inputs.home-manager.lib.homeManagerConfiguration {
      inherit pkgs;
      modules = [ identity ];
    });
    addedOptionNames = module: lib.subtractLists baselineOptionNames (optionNames (mkHome module));
    invalidOptionNames = builtins.filter (
      name: !(lib.hasPrefix "brucenunk.homeManager." name)
    ) (lib.unique (lib.concatMap addedOptionNames (builtins.attrValues nativeModules)));
    activationDrvs = map (
      module: (mkHome module).activationPackage.drvPath
    ) (builtins.attrValues nativeModules);
  in
  assert builtins.attrNames exportedModules == expectedModuleNames;
  assert invalidOptionNames == [ ];
  builtins.deepSeq activationDrvs "${builtins.currentSystem} exported Home Manager modules evaluate with plain nixpkgs"
'
printf '\n'
