#!/usr/bin/env python3
"""Record and render line-oriented Nix internal-json stderr."""

from __future__ import annotations

import json
import os
import re
import signal
import sys
import time
from pathlib import Path

TOKEN_PATTERN = re.compile(rb"github\.com=[^\s\"']+")


def redact(data: bytes, token: bytes) -> bytes:
    if token:
        data = data.replace(token, b"<redacted-github-token>")
    return TOKEN_PATTERN.sub(b"github.com=<redacted-github-token>", data)


def display(line: str) -> None:
    if line.startswith("@bump-nix "):
        return
    if not line.startswith("@nix "):
        print(line, flush=True)
        return
    try:
        event = json.loads(line[5:])
    except json.JSONDecodeError:
        print(line, flush=True)
        return
    if not isinstance(event, dict):
        print(line, flush=True)
        return
    if event.get("action") == "start" and isinstance(event.get("text"), str):
        print(event["text"], flush=True)
    elif event.get("action") == "msg" and isinstance(event.get("msg"), str):
        print(event["msg"], flush=True)
    elif event.get("action") == "result" and event.get("type") in {101, 107}:
        fields = event.get("fields")
        if isinstance(fields, list):
            for field in fields:
                if isinstance(field, str):
                    print(field, flush=True)


def main() -> int:
    if len(sys.argv) != 2:
        print("Usage: timestamp-nix-log LOG_FILE", file=sys.stderr)
        return 64

    signal.signal(signal.SIGTTOU, signal.SIG_IGN)
    token = sys.stdin.buffer.readline().rstrip(b"\n")
    path = Path(sys.argv[1])
    try:
        descriptor = os.open(
            path, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_APPEND, 0o600
        )
        target = os.fdopen(descriptor, "a", encoding="utf-8")
    except OSError as error:
        print(f"timestamp-nix-log: cannot create capture: {error}", file=sys.stderr)
        return 74

    capture_failed = False
    display_failed = False
    try:
        for raw_line in sys.stdin.buffer:
            safe_line = redact(raw_line.rstrip(b"\n"), token)
            line = safe_line.decode("utf-8", errors="replace")
            if target is not None:
                try:
                    target.write(json.dumps({
                        "record": "output",
                        "timestamp_ns": time.monotonic_ns(),
                        "line": line,
                    }, separators=(",", ":")) + "\n")
                    target.flush()
                except OSError as error:
                    capture_failed = True
                    try:
                        print(
                            f"timestamp-nix-log: capture failed; draining stderr: {error}",
                            file=sys.stderr,
                        )
                    except OSError:
                        display_failed = True
                    target.close()
                    target = None
            if not display_failed:
                try:
                    display(line)
                except OSError:
                    display_failed = True
    finally:
        if target is not None:
            target.close()
    return 74 if capture_failed or display_failed else 0


if __name__ == "__main__":
    raise SystemExit(main())
