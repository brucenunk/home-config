#!/usr/bin/env bash
set +x
set +a
set +e
set -u
set +T +E
trap - DEBUG RETURN ERR
unset BASH_ENV ENV

usage() {
  cat >&2 <<'EOF'
Usage: nix-with-gh-token [--log-file FILE] -- COMMAND [ARG ...]

Run a trusted repository command with a private temporary PATH shim. Every
nested `nix` invocation receives the active stored GitHub CLI token as an
additive Nix option. With --log-file, record timestamped internal-json stderr.
EOF
}

log_file=
while (( $# > 0 )); do
  case $1 in
    --log-file)
      (( $# >= 2 )) || { usage; exit 64; }
      log_file=$2
      shift 2
      ;;
    --)
      shift
      break
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      usage
      exit 64
      ;;
  esac
done
(( $# > 0 )) || { usage; exit 64; }

for name in GH_TOKEN GITHUB_TOKEN GH_ENTERPRISE_TOKEN GITHUB_ENTERPRISE_TOKEN; do
  if [[ -n ${!name:-} ]]; then
    printf 'nix-with-gh-token: %s must be unset; use stored GitHub CLI authentication\n' \
      "$name" >&2
    exit 1
  fi
done
unset GH_TOKEN GITHUB_TOKEN GH_ENTERPRISE_TOKEN GITHUB_ENTERPRISE_TOKEN
unset github_token BUMP_NIX_LOG_READY_FILE BUMP_NIX_LOG_REDACTION BUMP_NIX_INTERNAL_JSON_LOGS
unset -f nix gh python3 2>/dev/null || true

resolve_external() {
  local name=$1
  local path
  path=$(type -P -- "$name") || {
    printf 'nix-with-gh-token: required command not found: %s\n' "$name" >&2
    return 127
  }
  case $path in
    /*) ;;
    *) path="$(cd "$(dirname -- "$path")" && pwd -P)/$(basename -- "$path")" ;;
  esac
  printf '%s\n' "$path"
}

real_nix=$(resolve_external nix) || exit $?
real_gh=$(resolve_external gh) || exit $?
script_dir=$(cd "$(dirname -- "$0")" && pwd -P)

"$real_gh" auth status --hostname github.com >/dev/null 2>&1 || {
  printf '%s\n' 'nix-with-gh-token: GitHub CLI is not authenticated' >&2
  exit 1
}
github_token_check=$("$real_gh" auth token --hostname github.com 2>/dev/null) || {
  printf '%s\n' 'nix-with-gh-token: could not read the active GitHub CLI token' >&2
  exit 1
}
[[ -n $github_token_check ]] || {
  unset github_token_check
  printf '%s\n' 'nix-with-gh-token: GitHub CLI returned an empty token' >&2
  exit 1
}
unset github_token_check

old_umask=$(umask)
umask 077
shim_dir=$(mktemp -d "${TMPDIR:-/tmp}/bump-nix.XXXXXX") || exit $?
shim_dir=$(cd "$shim_dir" && pwd -P) || exit $?
umask "$old_umask"
cleanup() {
  rm -rf -- "$shim_dir"
}
trap cleanup EXIT

if ! cat >"$shim_dir/nix" <<'EOF'
#!/usr/bin/env bash
set +x
set +a
set +e
set -u
set +T +E
trap - DEBUG RETURN ERR
unset BASH_ENV ENV
: "${BUMP_NIX_REAL_NIX:?}"
: "${BUMP_NIX_REAL_GH:?}"
unset github_token

github_token=$("$BUMP_NIX_REAL_GH" auth token --hostname github.com 2>/dev/null) || {
  printf '%s\n' 'nix-with-gh-token: could not refresh the GitHub CLI token' >&2
  exit 1
}
[[ -n $github_token ]] || {
  unset github_token
  printf '%s\n' 'nix-with-gh-token: GitHub CLI returned an empty token' >&2
  exit 1
}

options=(--option extra-access-tokens "github.com=$github_token")
if [[ ${BUMP_NIX_INTERNAL_JSON_LOGS:-0} == 1 ]]; then
  options+=(--log-format internal-json)
  printf '%s\n' '@bump-nix {"event":"invocation-start"}' >&2
fi
status=0
"$BUMP_NIX_REAL_NIX" "${options[@]}" "$@" || status=$?
unset github_token
if [[ ${BUMP_NIX_INTERNAL_JSON_LOGS:-0} == 1 ]]; then
  printf '@bump-nix {"event":"invocation-stop","status":%s}\n' "$status" >&2
fi
exit "$status"
EOF
then
  printf '%s\n' 'nix-with-gh-token: could not create the temporary Nix shim' >&2
  exit 1
fi
if ! chmod 700 "$shim_dir/nix"; then
  printf '%s\n' 'nix-with-gh-token: could not make the temporary Nix shim executable' >&2
  exit 1
fi

export BUMP_NIX_REAL_NIX=$real_nix
export BUMP_NIX_REAL_GH=$real_gh
export PATH="$shim_dir:$PATH"

run_trusted_command() {
  local command_pid= wait_status signal_status=
  set -m
  forward_command_signal() {
    case $1 in
      HUP) signal_status=129 ;;
      INT) signal_status=130 ;;
      QUIT) signal_status=131 ;;
      TERM) signal_status=143 ;;
    esac
    if [[ -n $command_pid ]]; then
      kill -s "$1" -- "-$command_pid" 2>/dev/null || true
    fi
  }
  trap 'forward_command_signal HUP' HUP
  trap 'forward_command_signal INT' INT
  trap 'forward_command_signal QUIT' QUIT
  trap 'forward_command_signal TERM' TERM

  "$@" <&0 &
  command_pid=$!
  if [[ -n $signal_status ]]; then
    kill -TERM -- "-$command_pid" 2>/dev/null || true
  fi
  while :; do
    wait_status=0
    wait "$command_pid" || wait_status=$?
    if ! kill -0 "$command_pid" 2>/dev/null; then
      break
    fi
  done

  trap - HUP INT QUIT TERM
  set +m
  [[ -z $signal_status ]] || return "$signal_status"
  return "$wait_status"
}

status=0
if [[ -z $log_file ]]; then
  export BUMP_NIX_INTERNAL_JSON_LOGS=0
  run_trusted_command "$@" || status=$?
else
  real_python=$(resolve_external python3) || exit $?
  [[ ! -e $log_file && ! -L $log_file ]] || {
    printf 'nix-with-gh-token: refusing to overwrite log: %s\n' "$log_file" >&2
    exit 1
  }
  if ! mkdir -p -- "$(dirname -- "$log_file")"; then
    printf '%s\n' 'nix-with-gh-token: could not create the log directory' >&2
    exit 1
  fi
  redaction_token=$("$real_gh" auth token --hostname github.com 2>/dev/null) || {
    printf '%s\n' 'nix-with-gh-token: could not read token for log redaction' >&2
    exit 1
  }
  [[ -n $redaction_token ]] || {
    unset redaction_token
    printf '%s\n' 'nix-with-gh-token: empty token for log redaction' >&2
    exit 1
  }

  run_logged_command() {
    local command_start_ns command_stop_ns command_status logger_status
    local capture_healthy effective_status finalizer_status
    local pipeline_statuses
    command_start_ns=$("$real_python" -c 'import time; print(time.monotonic_ns())')
    exec 3>&1
    {
      printf '%s\n' "$redaction_token"
      unset redaction_token
      export BUMP_NIX_INTERNAL_JSON_LOGS=1
      "$@" 2>&1 1>&3
    } | "$real_python" "$script_dir/timestamp-nix-log" "$log_file" >&2
    pipeline_statuses=("${PIPESTATUS[@]}")
    exec 3>&-
    command_stop_ns=$("$real_python" -c 'import time; print(time.monotonic_ns())')
    command_status=${pipeline_statuses[0]}
    logger_status=${pipeline_statuses[1]}
    capture_healthy=true
    (( logger_status == 0 )) || capture_healthy=false
    effective_status=$command_status
    if (( effective_status == 0 && logger_status != 0 )); then
      effective_status=$logger_status
    fi
    finalizer_status=0
    "$real_python" - "$log_file" "$command_start_ns" "$command_stop_ns" \
      "$effective_status" "$command_status" "$logger_status" \
      "$capture_healthy" <<'PY' || finalizer_status=$?
import json
import os
import sys

path, start_ns, stop_ns, status, command_status, logger_status, healthy = sys.argv[1:]
flags = os.O_WRONLY | os.O_APPEND
if hasattr(os, "O_NOFOLLOW"):
    flags |= os.O_NOFOLLOW
descriptor = os.open(path, flags)
with os.fdopen(descriptor, "a", encoding="utf-8") as target:
    target.write(json.dumps({
        "record": "command",
        "event": "start",
        "timestamp_ns": int(start_ns),
    }, separators=(",", ":")) + "\n")
    target.write(json.dumps({
        "record": "command",
        "event": "stop",
        "timestamp_ns": int(stop_ns),
        "status": int(status),
        "command_status": int(command_status),
        "logger_status": int(logger_status),
        "capture_healthy": healthy == "true",
    }, separators=(",", ":")) + "\n")
PY
    if (( effective_status == 0 && finalizer_status != 0 )); then
      effective_status=$finalizer_status
    fi
    return "$effective_status"
  }

  run_trusted_command run_logged_command "$@" || status=$?
  unset redaction_token
fi

unset BUMP_NIX_REAL_NIX BUMP_NIX_REAL_GH BUMP_NIX_INTERNAL_JSON_LOGS
exit "$status"
