#!/usr/bin/env python3
"""Run a command in its own process group with foreground-terminal ownership."""

from __future__ import annotations

import os
import signal
import sys


def main() -> int:
    if len(sys.argv) < 2:
        print("Usage: run-foreground-command COMMAND [ARG ...]", file=sys.stderr)
        return 64

    tty_fd = sys.stdin.fileno() if sys.stdin.isatty() else None
    try:
        original_foreground = os.tcgetpgrp(tty_fd) if tty_fd is not None else None
    except OSError:
        tty_fd = None
        original_foreground = None

    managed_signals = {signal.SIGHUP, signal.SIGINT, signal.SIGQUIT, signal.SIGTERM}
    original_mask = signal.pthread_sigmask(signal.SIG_BLOCK, managed_signals)
    release_read, release_write = os.pipe()
    child_pid = os.fork()
    if child_pid == 0:
        os.close(release_write)
        os.setpgid(0, 0)
        if not os.read(release_read, 1):
            os._exit(125)
        os.close(release_read)
        for received in managed_signals:
            signal.signal(received, signal.SIG_DFL)
        signal.pthread_sigmask(signal.SIG_SETMASK, original_mask)
        try:
            os.execvp(sys.argv[1], sys.argv[1:])
        except FileNotFoundError:
            os.write(2, f"command not found: {sys.argv[1]}\n".encode())
            os._exit(127)
        except OSError as error:
            os.write(2, f"could not execute {sys.argv[1]}: {error}\n".encode())
            os._exit(126)

    os.close(release_read)

    try:
        os.setpgid(child_pid, child_pid)
    except OSError:
        # The child may already have completed setpgid and exec or exited.
        pass

    def forward(received: int, _frame: object) -> None:
        try:
            os.killpg(child_pid, received)
        except ProcessLookupError:
            pass

    for received in managed_signals:
        signal.signal(received, forward)
    signal.pthread_sigmask(signal.SIG_SETMASK, original_mask)

    def set_foreground(process_group: int) -> None:
        if tty_fd is None:
            return
        previous_sigttou = signal.signal(signal.SIGTTOU, signal.SIG_IGN)
        try:
            os.tcsetpgrp(tty_fd, process_group)
        finally:
            signal.signal(signal.SIGTTOU, previous_sigttou)

    set_foreground(child_pid)
    os.write(release_write, b"1")
    os.close(release_write)

    try:
        while True:
            try:
                _, wait_status = os.waitpid(
                    child_pid, os.WUNTRACED | getattr(os, "WCONTINUED", 0)
                )
            except InterruptedError:
                continue
            if os.WIFSTOPPED(wait_status) and original_foreground is not None:
                set_foreground(original_foreground)
                os.killpg(original_foreground, signal.SIGTSTP)
                set_foreground(child_pid)
                os.killpg(child_pid, signal.SIGCONT)
                continue
            if hasattr(os, "WIFCONTINUED") and os.WIFCONTINUED(wait_status):
                continue
            break
    finally:
        if original_foreground is not None:
            try:
                set_foreground(original_foreground)
            except OSError:
                pass

    exit_code = os.waitstatus_to_exitcode(wait_status)
    return 128 - exit_code if exit_code < 0 else exit_code


if __name__ == "__main__":
    raise SystemExit(main())
