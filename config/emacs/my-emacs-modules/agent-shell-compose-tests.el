;;; agent-shell-compose-tests.el --- Isolated composer markup tests -*- lexical-binding: t -*-

(require 'ert)
(require 'agent-shell)
(require 'agent-shell-compose)
(require 'org)
(require 'mixed-pitch)
(require 'rainbow-delimiters)
(add-hook 'prog-mode-hook #'rainbow-delimiters-mode)
(add-hook 'emacs-lisp-mode-hook #'rainbow-delimiters-mode)

(defmacro agent-shell-compose-test--with-composer (markup &rest body)
  "Run BODY in a disposable native composer using MARKUP, with real JIT tracking."
  (declare (indent 1))
  `(let ((agent-shell-compose-markup ,markup)
         (agent-shell-viewport--clean-up nil)
         (agent-shell-viewport-edit-mode-hook '(agent-shell-compose-setup)))
     (cl-letf (((symbol-function 'agent-shell-viewport--update-header) #'ignore))
       (let ((composer (generate-new-buffer " *compose-test*")))
         (unwind-protect
             (with-current-buffer composer
               (agent-shell-viewport-edit-mode)
               (setq font-lock-mode t)
               (font-lock-mode-internal t)
               ,@body)
           (when (buffer-live-p composer)
             (with-current-buffer composer
               (set-buffer-modified-p nil) (kill-buffer composer))))))))

(defun agent-shell-compose-test--faces (text)
  "Return faces at the beginning of TEXT in the current buffer."
  (save-excursion
    (goto-char (point-min)) (search-forward text)
    (let ((faces (get-text-property (- (point) (length text)) 'face)))
      (if (listp faces) faces (list faces)))))

(defconst agent-shell-compose-test--org-draft
  "* Heading\nProse *bold* /italic/ ~code~ =verbatim= [[file:test][link]].\n\n#+begin_src emacs-lisp\n(let ((x \"hello\")) x)\n#+end_src\n\n#+begin_src diff\n@@ -1 +1 @@\n-old\n+new\n#+end_src\n\n#+begin_src unknown-language\nunknown body\n#+end_src\n\n#+begin_src\nuntyped body\n#+end_src\n\nAfter\n")

(ert-deftest agent-shell-compose-org-faces-and-visible-raw-text ()
  (let ((org-hide-emphasis-markers t) (org-hide-leading-stars t)
        (org-pretty-entities t) (org-link-descriptive t))
    (agent-shell-compose-test--with-composer 'org
      (let ((map (current-local-map)) (indent indent-line-function)
            (completion completion-at-point-functions))
        (insert agent-shell-compose-test--org-draft)
        (set-buffer-modified-p nil)
        (font-lock-ensure)
        (should (eq major-mode 'agent-shell-viewport-edit-mode))
        (should (eq map (current-local-map)))
        (should (eq indent indent-line-function))
        (should (equal completion completion-at-point-functions))
        (should-not (buffer-modified-p))
        (should (equal (buffer-substring-no-properties (point-min) (point-max))
                       agent-shell-compose-test--org-draft)))
      (dolist (pair '(("Heading" . org-level-1) ("bold" . bold) ("italic" . italic)
                      ("code" . org-code) ("verbatim" . org-verbatim)
                      ("(let" . rainbow-delimiters-depth-1-face)
                      ("let" . font-lock-keyword-face) ("hello" . font-lock-string-face)
                      ("@@ -1" . diff-hunk-header) ("old\n" . diff-removed)
                      ("new\n" . diff-added) ("unknown body" . org-block)
                      ("untyped body" . org-block)))
        (should (memq (cdr pair) (agent-shell-compose-test--faces (car pair)))))
      (should-not (memq 'org-block (agent-shell-compose-test--faces "After")))
      (dotimes (n (buffer-size))
        (dolist (prop '(display composition invisible org-src-invisible keymap help-echo))
          (should-not (get-text-property (1+ n) prop)))))))

(ert-deftest agent-shell-compose-org-incremental-blocks ()
  (agent-shell-compose-test--with-composer 'org
    (insert "#+begin_src emacs-lisp\n(let ((x \"hello\")) x)\n")
    (font-lock-ensure)
    (should-not (memq 'font-lock-string-face (agent-shell-compose-test--faces "hello")))
    (goto-char (point-max))
    (let ((beg (point)))
      (insert "#+end_src\n\nAfter\n")
      (font-lock-ensure beg (point-max)))
    (should (memq 'font-lock-string-face (agent-shell-compose-test--faces "hello")))
    (should-not (memq 'org-block (agent-shell-compose-test--faces "After")))
    (goto-char (point-min)) (search-forward "emacs-lisp") (replace-match "diff")
    (font-lock-ensure (- (point) 4) (point))
    (should-not (memq 'font-lock-string-face (agent-shell-compose-test--faces "hello")))
    (goto-char (point-min)) (search-forward "diff") (replace-match "emacs-lisp")
    (font-lock-ensure (- (point) 10) (point))
    (should (memq 'font-lock-string-face (agent-shell-compose-test--faces "hello")))
    (search-forward "#+end_src") (delete-char -1)
    (font-lock-ensure (1- (point)) (point))
    (should-not (memq 'font-lock-string-face (agent-shell-compose-test--faces "hello")))
    (insert "c") (font-lock-ensure (1- (point)) (point))
    (should (memq 'font-lock-string-face (agent-shell-compose-test--faces "hello")))
    (goto-char (point-min)) (delete-region (point-min) (line-beginning-position 2))
    (font-lock-ensure (point-min) (1+ (point-min)))
    (should-not (memq 'font-lock-string-face (agent-shell-compose-test--faces "hello")))))

(ert-deftest agent-shell-compose-org-only-faces-cross-the-boundary ()
  (agent-shell-compose-test--with-composer 'org
    (insert agent-shell-compose-test--org-draft)
    (let ((original (propertize "attachment" 'display '(image :type png :data "fixture")
                                'keymap (make-sparse-keymap)
                                'rear-nonsticky '(cursor-intangible) 'cursor-intangible t
                                'help-echo "Attachment" 'agent-shell-context-image t))
          (beg (point)))
      (insert original)
      ;; Simulate arbitrary presentation properties supplied by a source mode,
      ;; including Org's invisibility alias, not just ordinary Org defaults.
      (with-current-buffer (agent-shell-compose--org-buffer)
        (font-lock-ensure)
        (add-text-properties (point-min) (point-max)
                             '(org-src-invisible t invisible t display "hidden")))
      (dotimes (_ 2)
        (font-lock-flush) (font-lock-ensure)
        (dotimes (n (length original))
          (dolist (prop '(display invisible keymap rear-nonsticky cursor-intangible help-echo
                         agent-shell-context-image))
            (should (equal (get-text-property n prop original)
                           (get-text-property (+ beg n) prop)))))
        (should-not (text-property-not-all (point-min) (point-max) 'org-src-invisible nil))))))

(ert-deftest agent-shell-compose-selection-survives-mode-transitions ()
  (agent-shell-compose-test--with-composer 'org
    (insert "~code~\n") (font-lock-ensure)
    (let ((scratch agent-shell-compose--org-buffer)
          (generation agent-shell-compose--generation)
          (agent-shell-compose-markup 'markdown))
      (agent-shell-viewport-view-mode)
      (should-not (buffer-live-p scratch))
      (should (eq (agent-shell-compose-selected-markup) 'org))
      (should-not (memq #'agent-shell-compose--org-after-change after-change-functions))
      (agent-shell-viewport-edit-mode)
      (should (eq (agent-shell-compose-selected-markup) 'org))
      (should-not (eq generation agent-shell-compose--generation))
      (insert "~again~") (font-lock-ensure)
      (should (memq 'org-code (agent-shell-compose-test--faces "again"))))))

(ert-deftest agent-shell-compose-kills-private-buffer-with-composer ()
  (let (scratch)
    (agent-shell-compose-test--with-composer 'org
      (insert "~code~") (font-lock-ensure)
      (setq scratch agent-shell-compose--org-buffer))
    (should-not (buffer-live-p scratch))))

(ert-deftest agent-shell-compose-diff-blocks-preserve-selection ()
  (dolist (text '("-old\n+new" "  partial  " "\tλ\n> nested" "```\n````"))
    (should (equal (agent-shell-compose-diff-block text 'org)
                   (concat "#+begin_src diff\n" text
                           (unless (string-suffix-p "\n" text) "\n") "#+end_src\n\n")))
    (let ((fence (if (string-match-p "````" text) "`````" "```")))
      (should (equal (agent-shell-compose-diff-block text 'markdown)
                     (concat fence "diff\n" text
                             (unless (string-suffix-p "\n" text) "\n") fence "\n\n")))))
  (dolist (text '("#+END_SRC\n" "* Heading\n" "** Nested heading\n"))
    (should-error (agent-shell-compose-diff-block text 'org) :type 'user-error)))

(ert-deftest agent-shell-compose-org-copies-only-requested-or-refontified-ranges ()
  (agent-shell-compose-test--with-composer 'org
    (insert "First paragraph.\n\n")
    (dotimes (_ 1000) (insert "Unchanged distant prose.\n\n"))
    (insert "#+begin_src emacs-lisp\n(message \"distant\")\n#+end_src\n")
    (font-lock-ensure)
    (let ((target (current-buffer))
          (put (symbol-function 'put-text-property)) writes)
      (cl-letf (((symbol-function 'put-text-property)
                 (lambda (beg end prop value &optional object)
                   (when (and (eq target (current-buffer))
                              (memq prop '(face font-lock-face)))
                     (push (cons beg end) writes))
                   (funcall put beg end prop value object))))
        (agent-shell-compose--fontify-org (point-min) 20 nil)
        (should writes)
        (should (= (apply #'max (mapcar #'cdr writes)) 20))
        (setq writes nil)
        (goto-char (point-min)) (insert "Small edit ")
        (font-lock-ensure (point-min) (point)))
      (should writes)
      (should (< (apply #'max (mapcar #'cdr writes)) 1000)))))

(ert-deftest agent-shell-compose-org-restores-faces-after-font-lock-toggle ()
  (agent-shell-compose-test--with-composer 'org
    ;; `font-lock-mode' intentionally refuses invisible (space-prefixed)
    ;; buffers, even with batch suppression disabled.  Model a real viewport.
    (rename-buffer "*compose-font-lock-toggle*" t)
    (insert agent-shell-compose-test--org-draft)
    (font-lock-ensure)
    (should (memq 'org-code (agent-shell-compose-test--faces "code")))
    (let ((scratch agent-shell-compose--org-buffer)
          (noninteractive nil))
      (font-lock-mode -1)
      (should-not (memq 'org-code (agent-shell-compose-test--faces "code")))
      (should-not (buffer-live-p scratch))
      (font-lock-mode 1)
      (should font-lock-mode))
    (font-lock-ensure)
    (should (memq 'org-code (agent-shell-compose-test--faces "code")))
    (should (memq 'font-lock-string-face (agent-shell-compose-test--faces "hello")))))

(ert-deftest agent-shell-compose-org-reports-expanded-redisplay-bounds ()
  (agent-shell-compose-test--with-composer 'org
    (insert "#+begin_src emacs-lisp\n(message \"first\")\n")
    (dotimes (_ 100) (insert "(message \"more\")\n"))
    (font-lock-ensure)
    (let ((beg (point-max)))
      (goto-char beg) (insert "#+end_src\n")
      (let ((bounds (font-lock-fontify-region beg (point-max))))
        (should (eq (car bounds) 'jit-lock-bounds))
        (should (= (cadr bounds) (point-min)))
        (should (>= (cddr bounds) (point-max)))
        (should (memq 'font-lock-string-face (agent-shell-compose-test--faces "first")))))))

(ert-deftest agent-shell-compose-unknown-markup-is-an-error ()
  (should-error (agent-shell-compose-diff-block "code" 'unknown) :type 'user-error))

(ert-deftest agent-shell-compose-insert-source-block-prompts-and-leaves-point-in-body ()
  (dolist (markup '(org markdown))
    (agent-shell-compose-test--with-composer markup
      (let (prompted)
        (cl-letf (((symbol-function 'completing-read)
                   (lambda (_prompt candidates &rest _)
                     (should (member "emacs-lisp" candidates))
                     (should (member "diff" candidates))
                     (setq prompted t)
                     "emacs-lisp")))
          (call-interactively #'agent-shell-compose-insert-source-block))
        (should prompted))
      (should (equal (buffer-substring-no-properties (point-min) (point-max))
                     (if (eq markup 'org)
                         "#+begin_src emacs-lisp\n\n#+end_src\n\n"
                       "```emacs-lisp\n\n```\n\n")))
      (should (looking-at "\n"))
      (should (eq major-mode 'agent-shell-viewport-edit-mode))
      (let ((block (agent-shell-compose-block-at-point)))
        (should (= (point) (plist-get block :body-begin)))
        (should (eq (agent-shell-compose-block-mode block) 'emacs-lisp-mode))))))

(ert-deftest agent-shell-compose-insert-source-block-wraps-raw-region-in-place ()
  (dolist (markup '(org markdown))
    (agent-shell-compose-test--with-composer markup
      (let ((body "  (message \"λ and `code`\")\n")
            (transient-mark-mode t))
        (insert "Before ")
        (push-mark (point) t t)
        (insert (propertize body 'help-echo "preserved"))
        (let ((end (point)))
          (insert "After") (goto-char end))
        (agent-shell-compose-insert-source-block "emacs-lisp")
        (should deactivate-mark)
        (should (equal (buffer-substring-no-properties (point-min) (point-max))
                       (concat "Before \n"
                               (if (eq markup 'org) "#+begin_src emacs-lisp\n" "```emacs-lisp\n")
                               body (if (eq markup 'org) "#+end_src\n\n" "```\n\n")
                               "After")))
        (should (looking-at "  (message"))
        (should (equal (get-text-property (point) 'help-echo) "preserved"))
        (font-lock-ensure)
        (should (memq 'font-lock-string-face (agent-shell-compose-test--faces "λ and")))))))

(ert-deftest agent-shell-compose-insert-source-block-allows-untyped-and-unknown-language ()
  (dolist (markup '(org markdown))
    (dolist (language '("" "unknown-language"))
      (agent-shell-compose-test--with-composer markup
        (agent-shell-compose-insert-source-block language)
        (should (eq (agent-shell-compose-block-mode (agent-shell-compose-block-at-point))
                    'fundamental-mode))))))

(ert-deftest agent-shell-compose-insert-source-block-cancellation-does-not-change-draft ()
  (dolist (markup '(org markdown))
    (agent-shell-compose-test--with-composer markup
      (insert "Keep this draft") (goto-char 6)
      (let ((before (buffer-string)) (pos (point)))
        (cl-letf (((symbol-function 'completing-read)
                   (lambda (&rest _) (signal 'quit nil))))
          (should (eq (condition-case nil
                          (call-interactively #'agent-shell-compose-insert-source-block)
                        (quit 'cancelled))
                      'cancelled)))
        (should (equal-including-properties (buffer-string) before))
        (should (= (point) pos))))))

(ert-deftest agent-shell-compose-insert-source-block-refuses-invalid-body-or-language ()
  (dolist (body '("#+END_SRC" "* Heading"))
    (agent-shell-compose-test--with-composer 'org
      (let ((transient-mark-mode t))
        (insert body) (push-mark (point-min) t t)
        (should-error (agent-shell-compose-insert-source-block "diff") :type 'user-error)
        (should (equal (buffer-substring-no-properties (point-min) (point-max)) body)))))
  (dolist (markup '(org markdown))
    (agent-shell-compose-test--with-composer markup
      (insert "Keep draft")
      (dolist (language '("bad\nlanguage" "bad name" "bad`name"))
        (should-error (agent-shell-compose-insert-source-block language) :type 'user-error)
        (should (equal (buffer-substring-no-properties (point-min) (point-max)) "Keep draft")))
      (erase-buffer)
      (agent-shell-compose-insert-source-block "diff")
      (let ((before (buffer-substring-no-properties (point-min) (point-max))))
        (should-error (agent-shell-compose-insert-source-block "diff") :type 'user-error)
        (should (equal (buffer-substring-no-properties (point-min) (point-max)) before)))))
  (with-temp-buffer
    (cl-letf (((symbol-function 'completing-read)
               (lambda (&rest _) (ert-fail "Prompted outside a composer"))))
      (should-error (call-interactively #'agent-shell-compose-insert-source-block)
                    :type 'user-error))))

(ert-deftest agent-shell-compose-insert-source-block-is-undoable ()
  (dolist (markup '(org markdown))
    (agent-shell-compose-test--with-composer markup
      (insert "BeforeAfter") (goto-char 7)
      (buffer-enable-undo) (setq buffer-undo-list nil)
      (agent-shell-compose-insert-source-block "diff")
      (undo-boundary) (undo-only)
      (font-lock-ensure)
      (should (equal (buffer-substring-no-properties (point-min) (point-max)) "BeforeAfter")))))

(ert-deftest agent-shell-compose-insert-source-block-markdown-uses-longer-fences ()
  (agent-shell-compose-test--with-composer 'markdown
    (let ((transient-mark-mode t))
      (insert "literal ```` markers") (push-mark (point-min) t t)
      (agent-shell-compose-insert-source-block "text")
      (should (equal (buffer-substring-no-properties (point-min) (point-max))
                     "`````text\nliteral ```` markers\n`````\n\n")))))

(ert-deftest agent-shell-compose-insert-source-block-preserves-images-on-refusal ()
  (dolist (markup '(org markdown))
    (agent-shell-compose-test--with-composer markup
      (let ((transient-mark-mode t))
        (insert (propertize "image" 'agent-shell-context-image t 'display "preview"))
        (push-mark (point-min) t t)
        (should-error (agent-shell-compose-insert-source-block "text") :type 'user-error)
        (should (equal (buffer-substring-no-properties (point-min) (point-max)) "image"))
        (should (get-text-property (point-min) 'agent-shell-context-image))
        (should (equal (get-text-property (point-min) 'display) "preview"))))))

(ert-deftest agent-shell-compose-insert-consecutive-blocks-on-trailing-blank-lines ()
  (dolist (markup '(org markdown))
    (agent-shell-compose-test--with-composer markup
      (agent-shell-compose-insert-source-block "diff")
      (let ((first (agent-shell-compose-block-at-point)))
        (goto-char (point-max))
        (should-not (agent-shell-compose-block-at-point))
        (agent-shell-compose-insert-source-block "emacs-lisp")
        (let ((second (agent-shell-compose-block-at-point)))
          (should (> (plist-get second :begin) (plist-get first :end)))
          (should (equal (plist-get second :language) "emacs-lisp")))))))

(ert-deftest agent-shell-compose-insert-refuses-unfinished-source-blocks ()
  (dolist (case '((org . "#+begin_src python\nbody\n")
                  (org . "#+begin_src org\n#+begin_comment\nbody\n")
                  (org . "#+begin_src python\nbody\n#+end_src oops\n")
                  (markdown . "```python\nbody\n")
                  (markdown . "~~~python\nbody\n")))
    (agent-shell-compose-test--with-composer (car case)
      (insert (cdr case))
      (should-error (agent-shell-compose-insert-source-block "diff") :type 'user-error)
      (should (equal (buffer-substring-no-properties (point-min) (point-max)) (cdr case)))))
  (dolist (kind '("example" "comment"))
    (agent-shell-compose-test--with-composer 'org
      ;; Literal begin_src text in a closed container must not poison later prose.
      (insert (format "#+begin_%s\n#+begin_src python\n#+end_%s\n\n" kind kind))
      (agent-shell-compose-insert-source-block "diff")
      (should (equal (plist-get (agent-shell-compose-block-at-point) :language) "diff")))))

(ert-deftest agent-shell-compose-org-initial-jit-keeps-distant-blocks-unfontified ()
  (agent-shell-compose-test--with-composer 'org
    (insert "* Heading\nVisible prose.\n\n")
    (dotimes (_ 1000) (insert "Distant prose.\n\n"))
    (insert "#+begin_src emacs-lisp\n(message \"distant string\")\n#+end_src\n")
    (font-lock-ensure (point-min) 20)
    (should (memq 'org-level-1 (agent-shell-compose-test--faces "Heading")))
    (with-current-buffer agent-shell-compose--org-buffer
      (goto-char (point-min)) (search-forward "distant string")
      (should-not (get-text-property (1- (point)) 'fontified))
      (should-not (memq 'font-lock-string-face
                        (agent-shell-compose-test--faces "distant string"))))))

(ert-deftest agent-shell-compose-org-scroll-copies-already-fontified-source-faces ()
  (agent-shell-compose-test--with-composer 'org
    (insert "Prose first.\n\n#+begin_src emacs-lisp\n")
    (let (later)
      (dotimes (i 100)
        (when (= i 50) (setq later (point)))
        (insert (format "(message \"line %d\")\n" i)))
      (insert "#+end_src\n")
      (font-lock-ensure (point-min) 70)
      (with-current-buffer agent-shell-compose--org-buffer
        (should (get-text-property later 'fontified)))
      (should-not (memq 'font-lock-string-face (agent-shell-compose-test--faces "line 50")))
      (font-lock-ensure later (+ later 20))
      (should (memq 'font-lock-string-face (agent-shell-compose-test--faces "line 50"))))))

(ert-deftest agent-shell-compose-insert-rejects-either-region-end-inside-a-block ()
  (dolist (markup '(org markdown))
    (dolist (incomplete '(nil t))
      (dolist (reverse '(nil t))
        (agent-shell-compose-test--with-composer markup
          (let* ((transient-mark-mode t)
                 (draft (concat "Prose\n"
                                (if (eq markup 'org) "#+begin_src diff\n" "```diff\n")
                                "body\n"
                                (unless incomplete
                                  (if (eq markup 'org) "#+end_src\n" "```\n")))))
            (insert draft)
            (goto-char (point-min)) (search-forward "body")
            (let ((inside (1- (point))))
              (goto-char (if reverse inside (point-min)))
              (push-mark (if reverse (point-min) inside) t t)
              (should-error (agent-shell-compose-insert-source-block "text") :type 'user-error)
              (should (equal (buffer-substring-no-properties (point-min) (point-max)) draft)))))))))

(ert-deftest agent-shell-compose-insert-refuses-unfinished-org-before-a-later-heading ()
  (dolist (where '(body heading))
    (agent-shell-compose-test--with-composer 'org
      (let ((draft "#+begin_src python\nbody\n* Next\n"))
        (insert draft)
        (goto-char (point-min))
        (search-forward (if (eq where 'body) "body" "* Next"))
        (beginning-of-line)
        (should-error (agent-shell-compose-insert-source-block "diff") :type 'user-error)
        (should (equal (buffer-substring-no-properties (point-min) (point-max)) draft))))))

(ert-deftest agent-shell-compose-language-modes-are-shared-and-composer-local ()
  (let ((agent-shell-compose-language-modes '(("custom-lisp" . emacs-lisp-mode)))
        (org-global (default-value 'org-src-lang-modes))
        (markdown-global (default-value 'markdown-code-lang-modes)))
    (dolist (markup '(org markdown))
      (agent-shell-compose-test--with-composer markup
        (agent-shell-compose-insert-source-block "custom-lisp")
        (insert "(message \"mapped language\")\n")
        (font-lock-ensure)
        (should (memq 'font-lock-string-face
                      (agent-shell-compose-test--faces "mapped language")))
        (should (eq (agent-shell-compose-block-mode (agent-shell-compose-block-at-point))
                    'emacs-lisp-mode))
        (when (eq markup 'org)
          (with-current-buffer agent-shell-compose--org-buffer
            (should (eq (alist-get "custom-lisp" org-src-lang-modes nil nil #'equal)
                        'emacs-lisp))))))
    (should (equal (default-value 'org-src-lang-modes) org-global))
    (should (equal (default-value 'markdown-code-lang-modes) markdown-global))))

