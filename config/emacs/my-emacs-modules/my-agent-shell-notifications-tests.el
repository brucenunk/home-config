;;; my-agent-shell-notifications-tests.el --- Attention policy tests -*- lexical-binding: t -*-

;;; Commentary:
;; Isolated public event fixtures; never show a GUI, play audio or start ACP.

;;; Code:

(require 'ert)
(require 'cl-lib)
(require 'my-agent-shell-notifications)

(defmacro my/agent-notification-test--isolated (&rest body)
  "Run BODY in a disposable shell with isolated notification state."
  (declare (indent 0))
  `(let ((agent-shell-notifications--subscriptions nil)
         (agent-shell-notifications--timers nil)
         (agent-shell-notifications--notification-ids nil)
         (my/agent-notification-sound-file nil))
     (with-temp-buffer
       ;; No native agent startup: the public event API only needs this state.
       (setq major-mode 'agent-shell-mode)
       (setq-local agent-shell--state
                   (list (cons :buffer (current-buffer))
                         (cons :event-subscriptions nil)))
       (cl-letf (((symbol-function 'agent-shell--sync-system-sleep) #'ignore)
                 ((symbol-function 'display-graphic-p) (lambda (&rest _) nil)))
         (unwind-protect
             (progn (my/agent-notification--setup) ,@body)
           (agent-shell-notifications-mode -1))))))

(ert-deftest my/agent-notification-event-filtering-and-pending-state ()
  (my/agent-notification-test--isolated
    (let (sent)
      (cl-letf (((symbol-function 'my/agent-notification--active-p) #'ignore)
                ((symbol-function 'my/agent-notification--play)
                 (lambda () (push t sent))))
        (agent-shell--emit-event :event 'turn-complete :data '((:stop-reason . "cancelled")))
        (should-not sent)
        (should-not my/agent-notification--reply-pending)
        (agent-shell--emit-event :event 'turn-complete :data '((:stop-reason . "end_turn")))
        (should (= 1 (length sent)))
        (should my/agent-notification--reply-pending)
        (agent-shell--emit-event :event 'input-submitted)
        (should-not my/agent-notification--reply-pending)
        (dolist (id '(1 2))
          (agent-shell--emit-event :event 'permission-request :data (list (cons :request-id id))))
        (should (= 3 (length sent)))
        (should (equal my/agent-notification--permissions '(2 1)))
        (agent-shell--emit-event :event 'input-submitted)
        (should (equal my/agent-notification--permissions '(2 1)))
        (my/agent-notification--acknowledge)
        (should my/agent-notification--permissions)
        (agent-shell--emit-event :event 'permission-response :data '((:request-id . 1)))
        (should (equal my/agent-notification--permissions '(2)))
        (agent-shell--emit-event :event 'permission-response :data '((:request-id . 2)))
        (should-not my/agent-notification--permissions)))))

(ert-deftest my/agent-notification-active-versus-visible-afk ()
  (my/agent-notification-test--isolated
    (let ((shell (current-buffer)))
      (cl-letf (((symbol-function 'window-buffer) (lambda (&rest _) shell))
                ((symbol-function 'frame-focus-state) (lambda (&rest _) t))
                ((symbol-function 'current-idle-time) (lambda (&rest _) nil)))
        (should (my/agent-notification--active-p shell))
        (cl-letf (((symbol-function 'current-idle-time) (lambda () (seconds-to-time 20))))
          (should-not (my/agent-notification--active-p shell)))
        (cl-letf (((symbol-function 'frame-focus-state) (lambda (&rest _) nil)))
          (should-not (my/agent-notification--active-p shell)))))))

(ert-deftest my/agent-notification-delay-and-viewport-acknowledgement ()
  (my/agent-notification-test--isolated
    (let ((shell (current-buffer)) fired)
      (cl-letf (((symbol-function 'my/agent-notification--active-p) (lambda (_) t))
                ((symbol-function 'run-with-timer)
                 (lambda (seconds repeat function &rest args)
                   (should (= seconds 10))
                   (should-not repeat)
                   (setq fired (lambda () (apply function args)))
                   'fixture-timer))
                ((symbol-function 'cancel-timer) #'ignore))
        (agent-shell--emit-event :event 'turn-complete :data '((:stop-reason . "end_turn")))
        (should fired)
        (should agent-shell-notifications--timers)
        (with-temp-buffer
          (setq major-mode 'agent-shell-viewport-edit-mode)
          (cl-letf (((symbol-function 'agent-shell-viewport--shell-buffer) (lambda (&rest _) shell)))
            (my/agent-notification--viewport-setup)
            (run-hooks 'post-command-hook)))
        (should-not agent-shell-notifications--timers)
        (should-not my/agent-notification--reply-pending)))))

(ert-deftest my/agent-notification-delayed-format-keeps-source-session ()
  (my/agent-notification-test--isolated
    (let ((source (current-buffer)) callback notification)
      (cl-letf (((symbol-function 'my/agent-notification--active-p) (lambda (_) t))
                ((symbol-function 'run-with-timer)
                 (lambda (_seconds _repeat fn &rest args)
                   (setq callback (lambda () (apply fn args))) 'fixture))
                ((symbol-function 'cancel-timer) #'ignore)
                (agent-shell-notifications-send-function
                 (lambda (plist) (setq notification plist) 'fixture)))
        (agent-shell--emit-event :event 'turn-complete :data '((:stop-reason . "end_turn")))
        (with-temp-buffer (funcall callback))
        (should (equal (plist-get notification :body) (buffer-name source)))))))

(ert-deftest my/agent-notification-audio-only-on-graphical-and-terminal-displays ()
  (dolist (graphical '(t nil))
    (my/agent-notification-test--isolated
      (let ((played 0))
        (cl-letf (((symbol-function 'display-graphic-p) (lambda (&rest _) graphical))
                  ((symbol-function 'my/agent-notification--active-p) #'ignore)
                  ((symbol-function 'my/agent-notification--play)
                   (lambda () (cl-incf played)))
                  ((symbol-function 'knockknock-notify)
                   (lambda (&rest _) (ert-fail "Popup displayed")))
                  ((symbol-function 'notifications-notify)
                   (lambda (&rest _) (ert-fail "Desktop notification displayed")))
                  ((symbol-function 'set-transient-map)
                   (lambda (&rest _) (ert-fail "RET takeover")))
                  ((symbol-function 'select-frame-set-input-focus)
                   (lambda (&rest _) (ert-fail "Focus stolen"))))
          (agent-shell--emit-event :event 'turn-complete :data '((:stop-reason . "end_turn")))
          (should (= played 1))
          (agent-shell--emit-event :event 'input-submitted)
          (should (= played 1))
          (should-not agent-shell-notifications--notification-ids)
          (should-not (alist-get 'agent-shell-notifications-mode minor-mode-alist)))))))

(ert-deftest my/agent-notification-audio-provider-ids-and-close ()
  (let ((played 0))
    (cl-letf (((symbol-function 'my/agent-notification--play)
               (lambda () (cl-incf played))))
      (let ((old (my/agent-notification--send nil))
            (new (my/agent-notification--send nil)))
        (should old)
        (should new)
        (should-not (eq old new))
        (my/agent-notification--close old)
        (my/agent-notification--close new)
        (should (= played 2))))))

(ert-deftest my/agent-notification-sound-is-local-on-both-platforms ()
  (dolist (platform '(darwin gnu/linux))
    (let ((system-type platform)
          (default-directory "/rpc:user@offline.invalid:/srv/repo/")
          (my/agent-notification-sound-file "/local/attention.wav")
          command)
      (cl-letf (((symbol-function 'executable-find)
                 (lambda (name &rest _)
                   (should-not (file-remote-p default-directory))
                   (should (equal name "paplay")) "/local/bin/paplay"))
                ((symbol-function 'file-readable-p)
                 (lambda (path) (should (equal path "/local/attention.wav")) t))
                ((symbol-function 'make-process)
                 (lambda (&rest args)
                   (should-not (file-remote-p default-directory))
                   (should (plist-get args :noquery))
                   (setq command (plist-get args :command)))))
        (my/agent-notification--play)
        (should (equal command (list (if (eq platform 'darwin) "/usr/bin/afplay" "/local/bin/paplay")
                                    "/local/attention.wav")))))))

(ert-deftest my/agent-notification-navigation-uses-viewport-and-keeps-permission-pending ()
  (my/agent-notification-test--isolated
    (let ((shell (current-buffer)) visited)
      (setq my/agent-notification--reply-pending t)
      (agent-shell--emit-event :event 'permission-request :data '((:request-id . 1)))
      ;; Accepted steering must not hide a session still awaiting permission.
      (agent-shell--emit-event :event 'input-submitted)
      (should-not my/agent-notification--reply-pending)
      (cl-letf (((symbol-function 'completing-read)
                 (lambda (_prompt choices &rest _) (should (member (buffer-name shell) choices))
                   (buffer-name shell)))
                ((symbol-function 'agent-shell-notifications--switch-to-shell)
                 (lambda (target) (setq visited target))))
        (my/agent-notification-visit-waiting)
        (should (eq visited shell))
        (should-not my/agent-notification--reply-pending)
        (should my/agent-notification--permissions)))))

(ert-deftest my/agent-notification-setup-and-kill-clean-up ()
  (let ((agent-shell-notifications--subscriptions nil)
        (agent-shell-notifications--timers nil)
        (agent-shell-notifications--notification-ids nil)
        (shell (generate-new-buffer " *notification-cleanup-test*")))
    (unwind-protect
        (with-current-buffer shell
          (setq major-mode 'agent-shell-mode)
          (setq-local agent-shell--state (list (cons :buffer shell)
                                               (cons :event-subscriptions nil)))
          (my/agent-notification--setup)
          (my/agent-notification--setup)
          (should (= 4 (length (map-elt agent-shell--state :event-subscriptions)))))
      ;; with-temp-buffer deliberately suppresses kill hooks; exercise a real kill.
      (kill-buffer shell))
    (should-not agent-shell-notifications--subscriptions)
    (should-not agent-shell-notifications--timers)
    (should-not agent-shell-notifications--notification-ids)))

(ert-deftest my/agent-notification-audio-cues-never-fetch-icons ()
  (my/agent-notification-test--isolated
    (push '(:agent-config . ((:icon-name . "pi.png"))) agent-shell--state)
    (let (sent)
      (cl-letf (((symbol-function 'my/agent-notification--active-p) #'ignore)
                ((symbol-function 'agent-shell--fetch-agent-icon)
                 (lambda (&rest _) (ert-fail "Notification fetched an unused icon")))
                (agent-shell-notifications-send-function
                 (lambda (plist) (setq sent plist) 'fixture)))
        (agent-shell--emit-event :event 'turn-complete :data '((:stop-reason . "end_turn")))
        (should sent)
        (should-not (plist-get sent :app-icon))))))

(ert-deftest my/agent-notification-load-never-requires-visual-backends ()
  (let ((original-require (symbol-function 'require)))
    (cl-letf (((symbol-function 'require)
               (lambda (feature &rest args)
                 (when (memq feature '(knockknock posframe
                                      agent-shell-notifications-knockknock
                                      agent-shell-notifications-libnotify))
                   (ert-fail (format "Visual backend required: %s" feature)))
                 (apply original-require feature args))))
      (load "my-agent-shell-notifications" nil t)
      (should-not agent-shell-notifications-provider)
      (should (eq agent-shell-notifications-send-function #'my/agent-notification--send))
      (should (eq agent-shell-notifications-close-function #'my/agent-notification--close)))))

(provide 'my-agent-shell-notifications-tests)
;;; my-agent-shell-notifications-tests.el ends here