(ert-deftest my/excali-org-indirect-views-own-their-overlays ()
  (my/excali-test--org-scene
   (let ((custom-enabled-themes '(doric-earth))
         indirect)
     (save-window-excursion
       (switch-to-buffer (current-buffer))
       (cl-letf (((symbol-function 'display-graphic-p) (lambda (&rest _) t))
                 ((symbol-function 'image-flush) #'ignore))
         (my/excali--org-display)
         (let* ((original (current-buffer))
                (original-overlay (car org-link-preview-overlays))
                (original-image (overlay-get original-overlay 'display)))
           (unwind-protect
               (progn
                 (setq indirect (clone-indirect-buffer " *excali-indirect*" nil))
                 (set-window-buffer (split-window-below) indirect)
                 (my/excali--org-resize)
                 (should (eq (overlay-buffer original-overlay) original))
                 (should (eq original-image (overlay-get original-overlay 'display)))
                 (with-current-buffer indirect
                   (should (= (length org-link-preview-overlays) 1))
                   (should (eq (overlay-buffer (car org-link-preview-overlays)) indirect))
                   (org-link-preview-clear)
                   (should-not org-link-preview-overlays))
                 (should (eq (overlay-buffer original-overlay) original))
                 (should (eq original-image (overlay-get original-overlay 'display)))
                 (should (= (length org-link-preview-overlays) 1)))
             (when (buffer-live-p indirect) (kill-buffer indirect)))))))))

(ert-deftest my/excali-org-asynchronous-batches-size-every-window ()
  (my/excali-test--org-scene
   (let ((custom-enabled-themes '(doric-earth))
         (org-link-preview-batch-size 1))
     (erase-buffer)
     (dotimes (_ 3) (insert "[[excali:../diagrams/scene.excalidraw]]\n\n"))
     (save-window-excursion
       (switch-to-buffer (current-buffer))
       (let ((second (split-window-below)))
         (set-window-margins second 5 5)
         (cl-letf (((symbol-function 'display-graphic-p) (lambda (&rest _) t))
                   ((symbol-function 'image-flush) #'ignore))
           ;; Native refresh queues all diagrams at once, unlike opening's
           ;; one-link calls.  Finish the real idle queue without a layout event.
           (org-link-preview-refresh)
           (should org-link-preview--queue)
           (while org-link-preview--queue
             (when (timerp org-link-preview--timer) (cancel-timer org-link-preview--timer))
             (org-link-preview--process-queue (current-buffer)))
           (should (= (length org-link-preview-overlays) 6))
           (dolist (ov org-link-preview-overlays)
             (let ((window (overlay-get ov 'window))
                   (image (overlay-get ov 'display)))
               (should (window-live-p window))
               (should (= (plist-get (cdr image) :width)
                          (min (my/excali--org-default-width window) (window-body-width window t))))))
           ;; Re-display without refresh must reuse each window's overlay.
           (dotimes (_ 3)
             (org-link-preview-region t)
             (while org-link-preview--queue
               (when (timerp org-link-preview--timer) (cancel-timer org-link-preview--timer))
               (org-link-preview--process-queue (current-buffer))))
           (should (= (length org-link-preview-overlays) 6))
           (should (= (length (delete-dups (copy-sequence org-link-preview-overlays))) 6))))))))

(ert-deftest my/excali-org-layout-preserves-hidden-widths-and-explicit-alignments ()
  (my/excali-test--org-scene
   (let ((custom-enabled-themes '(doric-earth)))
     (erase-buffer)
     (insert "* One\n#+ATTR_ORG: :width 20 :align right\n"
             "[[excali:../diagrams/scene.excalidraw]]\n"
             "* Two\n#+ATTR_ORG: :width 40 :align left\n"
             "[[excali:../diagrams/scene.excalidraw]]\n")
     (save-window-excursion
       (switch-to-buffer (current-buffer))
       (cl-letf (((symbol-function 'display-graphic-p) (lambda (&rest _) t)))
         (my/excali--org-display)
         (goto-char (point-min))
         (org-narrow-to-subtree)
         (my/excali--org-resize)
         (let* ((overlays (sort (copy-sequence org-link-preview-overlays)
                                (lambda (a b) (< (overlay-start a) (overlay-start b)))))
                (right (car overlays)) (left (cadr overlays)))
           (should (= (plist-get (cdr (overlay-get right 'display)) :width) 20))
           (should (= (plist-get (cdr (overlay-get left 'display)) :width) 40))
           (should (eq (cadr (plist-get (cdr (get-text-property
                                             0 'display (overlay-get right 'before-string)))
                                       :align-to)) 'right))
           (should-not (overlay-get left 'before-string)))
         (widen))))))

(ert-deftest my/excali-org-opening-layout-work-is-linear ()
  (my/excali-test--org-scene
   (let ((custom-enabled-themes '(doric-earth))
         (size (symbol-function 'my/excali--org-size-overlay))
         (count 0))
     (erase-buffer)
     (dotimes (_ 10) (insert "[[excali:../diagrams/scene.excalidraw]]\n\n"))
     (save-window-excursion
       (switch-to-buffer (current-buffer))
       (cl-letf (((symbol-function 'display-graphic-p) (lambda (&rest _) t))
                 ((symbol-function 'my/excali--org-size-overlay)
                  (lambda (&rest args) (cl-incf count) (apply size args))))
         (my/excali--org-display)
         (should (= (length org-link-preview-overlays) 10))
         (should (<= count 20)))))))

(ert-deftest my/excali-org-described-links-use-native-batching-on-open-and-refresh ()
  (my/excali-test--org-scene
   (let ((custom-enabled-themes '(doric-earth))
         (org-link-preview-batch-size 1))
     (cl-letf (((symbol-function 'display-graphic-p) (lambda (&rest _) t))
               ((symbol-function 'image-flush) #'ignore))
       (dolist (display '(my/excali--org-display org-link-preview-refresh))
         (erase-buffer)
         (dotimes (_ 3) (insert "[[excali:../diagrams/scene.excalidraw][Diagram]]\n\n"))
         (funcall display)
         (should (= (length org-link-preview--queue) 2))
         (should (= (seq-count (lambda (ov) (overlay-get ov 'display)) org-link-preview-overlays) 1))
         (while org-link-preview--queue
           (when (timerp org-link-preview--timer) (cancel-timer org-link-preview--timer))
           (org-link-preview--process-queue (current-buffer)))
         (should (= (seq-count (lambda (ov) (overlay-get ov 'display)) org-link-preview-overlays) 3)))))))

(ert-deftest my/excali-org-html-preserves-explicit-alternative-text ()
