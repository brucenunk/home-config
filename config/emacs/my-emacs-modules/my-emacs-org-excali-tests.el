(ert-deftest my/excali-org-render-does-not-touch-live-source ()
  (require 'org)
  (my/excali-test--org-scene
   (let ((org-buffer (current-buffer)))
     (my/excali-test--conversion-scene
      (setq excali--file source)
      (excali--set-element-style (car excali--elements) 'x 123)
      (excali--commit) (excali-undo)
      (set-buffer-modified-p t)
      (let ((state (my/excali-test--conversion-state))
            (undo excali--undo-stack) (redo excali--redo-stack)
            (selection excali--selection) (cache excali--native-cache)
            (text (buffer-string)))
        (with-current-buffer org-buffer
          (my/excali--org-image "../diagrams/scene.excalidraw" t))
        (should (equal state (my/excali-test--conversion-state)))
        (should (eq undo excali--undo-stack))
        (should (eq redo excali--redo-stack))
        (should (eq selection excali--selection))
        (should (eq cache excali--native-cache))
        (should (equal text (buffer-string)))
        (should (buffer-modified-p)))))))

(ert-deftest my/excali-org-insertion-opening-toggle-and-source-editing ()
  (require 'org)
  (my/excali-test--org-scene
   (let ((custom-enabled-themes '(doric-earth)))
     (save-window-excursion
       (switch-to-buffer (current-buffer))
       (erase-buffer)
       (cl-letf (((symbol-function 'display-graphic-p) (lambda (&rest _) t))
                 ((symbol-function 'image-flush) #'ignore))
         (dolist (description '("Image build" ""))
           (erase-buffer)
           ;; Exercise the real interactive C-c C-l completion/description flow.
           (cl-letf (((symbol-function 'org-completing-read) (lambda (&rest _) "excali:"))
                     ((symbol-function 'read-file-name) (lambda (&rest _) source))
                     ((symbol-function 'read-string) (lambda (&rest _) description)))
             (call-interactively #'org-insert-link))
           (should (= (length org-link-preview-overlays) 1))
           (goto-char (point-min))
           ;; Hiding exposes the authoritative link for C-c C-l editing.
           (org-link-preview)
           (should-not org-link-preview-overlays)
           (my/excali--org-resize)
           (should-not org-link-preview-overlays)
           (org-link-preview)
           (should (= (length org-link-preview-overlays) 1))
           (org-link-preview-clear)
           (my/excali--org-display)
           (should (= (length org-link-preview-overlays) 1))))))))

(ert-deftest my/excali-org-default-width-follows-frame-font-not-local-zoom ()
  (let ((my/excali-org-preview-width 120)
        (frame-width 7)
        (window (selected-window))
        (other-frame 'other-frame))
    (cl-letf (((symbol-function 'window-frame) (lambda (w) (should (eq w window)) other-frame))
              ((symbol-function 'frame-char-width)
               (lambda (frame) (should (eq frame other-frame)) frame-width))
              ((symbol-function 'window-font-width)
               (lambda (&rest _) (ert-fail "Preview cap must not use buffer-remapped font metrics"))))
      (should (= (my/excali--org-default-width window) 840))
      (let ((text-scale-mode-amount 3))
        (should (= (my/excali--org-default-width window) 840)))
      (setq frame-width 10)
      (should (= (my/excali--org-default-width window) 1200))
      (setq frame-width 14)
      (should (= (my/excali--org-default-width window) 1680))
      (setq my/excali-org-preview-width 100)
      (should (= (my/excali--org-default-width window) 1400)))))

(ert-deftest my/excali-org-default-width-is-capped-with-attribute-overrides ()
  (require 'org)
  (with-temp-buffer
    (org-mode)
    (let ((my/excali-org-preview-width 120)
          (area 1200)
          (font-width 7))
      (cl-letf (((symbol-function 'window-body-width) (lambda (&rest _) area))
                ((symbol-function 'frame-char-width) (lambda (&rest _) font-width))
                ((symbol-function 'line-number-display-width) (lambda (&rest _) 0))
                ((symbol-function 'create-image)
                 (lambda (file _type _data &rest props)
                   (append (list 'image :type 'svg :file file) props))))
        (cl-labels ((preview-width (attribute)
                      (erase-buffer)
                      (when attribute (insert "#+ATTR_ORG: :width " attribute "\n"))
                      (insert "[[excali:scene.excalidraw]]\n")
                      (goto-char (point-min))
                      (search-forward "[[")
                      (let ((ov (make-overlay (point) (point))))
                        (unwind-protect
                            (progn
                              (overlay-put ov 'my-excali-image "cached.svg")
                              (my/excali--org-size-overlay ov (selected-window) (org-element-context))
                              (should (eq (not (null (overlay-get ov 'before-string)))
                                          (< (plist-get (cdr (overlay-get ov 'display)) :width) area)))
                              (plist-get (cdr (overlay-get ov 'display)) :width))
                          (delete-overlay ov)))))
          (should (= (preview-width nil) 840))
          (should (= (preview-width "unsupported") 840))
          ;; Explicit widths bypass the default cap, not the available area.
          (should (= (preview-width "90%") 1080))
          (should (= (preview-width "1000px") 1000))
          (should (= (preview-width "600") 600))
          ;; Larger frame fonts scale the cap, still bounded by the window.
          (setq font-width 14)
          (should (= (preview-width nil) 1200))
          (setq area 2000)
          (should (= (preview-width nil) 1680))
          (setq my/excali-org-preview-width 100)
          (should (= (preview-width nil) 1400))
          (setq area 500)
          ;; Full-area previews have no centring spacer.
          (should (= (preview-width nil) 500))
          (should (= (preview-width "2000") 500)))))))

(ert-deftest my/excali-org-widths-follow-text-area-and-two-window-layouts ()
  (require 'org)
  (require 'writeroom-mode)
  (my/excali-test--org-scene
   (let ((custom-enabled-themes '(doric-earth)))
     (save-window-excursion
       (switch-to-buffer (current-buffer))
       (delete-other-windows)
       (cl-letf (((symbol-function 'display-graphic-p) (lambda (&rest _) t))
                 ((symbol-function 'image-flush) #'ignore))
         (cl-labels ((width (window)
                       (let ((ov (seq-find (lambda (ov) (eq (overlay-get ov 'window) window))
                                           org-link-preview-overlays)))
                         (plist-get (cdr (overlay-get ov 'display)) :width))))
           (my/excali--org-display)
           (should (= (width (selected-window))
                      (min (my/excali--org-default-width (selected-window)) (window-body-width nil t))))
           (should (= (plist-get (cdr (overlay-get (car org-link-preview-overlays) 'display)) :scale) 1))
           (let ((second (split-window-below)))
             (set-window-margins second 10 10)
             (my/excali--org-resize)
             (should (= (length org-link-preview-overlays) 2))
             (should (= (width second)
                        (min (my/excali--org-default-width second) (window-body-width second t))))
             (should (< (width second) (width (selected-window))))
             (delete-window second)
             (my/excali--org-resize)
             (should (= (length org-link-preview-overlays) 1)))
           (erase-buffer)
           (insert "#+ATTR_ORG: :width 90%\n[[excali:../diagrams/scene.excalidraw][Diagram]]\n")
           (my/excali--org-display)
           (should (= (width (selected-window)) (round (* 0.9 (window-body-width nil t)))))
           (should (overlay-get (car org-link-preview-overlays) 'before-string))
           (let ((writeroom-global-effects nil)
                 (writeroom-fullscreen-effect nil)
                 (writeroom-width 40)
                 (writeroom-maximize-window nil))
             (writeroom-mode 1)
             (my/excali--org-resize)
             (should (= (width (selected-window)) (round (* 0.9 (window-body-width nil t)))))
             (writeroom-mode -1)
             (my/excali--org-resize)
             (should (= (width (selected-window)) (round (* 0.9 (window-body-width nil t))))))
           (erase-buffer)
           (insert "#+ATTR_ORG: :width 20\n[[excali:../diagrams/scene.excalidraw]]\n")
           (my/excali--org-display)
           (should (= (width (selected-window)) 20))))))))

(ert-deftest my/excali-org-publication-descriptions-captions-and-portable-assets ()
  (require 'ox-html)
  (require 'ox-md)
  (my/excali-test--org-scene
   (erase-buffer)
   (insert "#+CAPTION: A useful caption\n"
           "[[excali:../diagrams/scene.excalidraw][Build & \"ship\"]]\n")
   (let* ((custom-enabled-themes '(doric-obsidian))
          (html (org-export-as 'html nil nil t))
          (md-file (expand-file-name "published dir/build (trial).md" directory)))
     (should (string-match-p (regexp-quote "alt=\"Build &amp; &quot;ship&quot;\"") html))
     (should (string-match-p "A useful caption" html))
     (should-not (string-match-p "file://" html))
     (should-not (string-match-p (regexp-quote my/excali-preview-directory) html))
     ;; The embedded bytes are exactly the Doric Light cached SVG.
     (should (string-match "src=\"data:image/svg[+]xml;base64,\\([^\"]+\\)\"" html))
     (let ((svg (base64-decode-string (match-string 1 html)))
           (file (my/excali--org-image "../diagrams/scene.excalidraw" t)))
       (should (equal svg (excali--read-image-file file))))
     (make-directory (file-name-directory md-file) t)
     (org-export-to-file 'md md-file nil nil nil t)
     (let ((md (with-temp-buffer (insert-file-contents md-file) (buffer-string)))
           (assets (concat (file-name-sans-extension md-file) "-assets/")))
       (should (string-match-p (regexp-quote "![Build & \"ship\"]") md))
       (should (string-match-p "build%20%28trial%29-assets/" md))
       (should (string-match-p "A useful caption" md))
       (should (= (length (directory-files assets nil "\\.svg\\'")) 1))
       (org-export-to-file 'md md-file nil nil nil t)
       (should (= (length (directory-files assets nil "\\.svg\\'")) 1))))))

