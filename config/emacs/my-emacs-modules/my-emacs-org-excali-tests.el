(ert-deftest my/excali-org-restores-legacy-scenes-before-rendering ()
  (require 'org)
  (my/excali-test--org-scene
   (let* ((doc (excali--read-scene-file source))
          (elements (append (alist-get 'elements doc) nil))
          (label (seq-find (lambda (e) (equal (alist-get 'id e) "label")) elements))
          (export (symbol-function 'excali-export-svg)))
     (excali--put label 'font "28px Virgil")
     (setf (alist-get 'fontSize label) nil)
     (with-temp-file source (insert (excali--serialize-doc doc elements)))
     (cl-letf (((symbol-function 'excali-export-svg)
                (lambda (&rest args)
                  (let ((restored (seq-find (lambda (e) (equal (alist-get 'id e) "label"))
                                            excali--elements)))
                    (should (= (alist-get 'fontSize restored) 28))
                    (should (= (alist-get 'fontFamily restored) 1)))
                  (apply export args))))
       (should (file-exists-p (my/excali--org-image "../diagrams/scene.excalidraw" t)))))))

