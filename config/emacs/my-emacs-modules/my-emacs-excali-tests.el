(ert-deftest my/excali-export-preserves-source-on-success-error-and-quit ()
  (dolist (outcome '(success error quit))
    (dolist (modified '(nil t))
      (my/excali-test--conversion-scene
       (excali--set-element-style (car excali--elements) 'x 123)
       (excali--commit)
       (excali-undo)
       (setq excali--selection (list (car excali--elements)))
       (setq-local excali-export-scale 2 excali-export-padding 23
                   excali-export-background nil excali-export-embed-scene nil)
       (set-buffer-modified-p modified)
       (let ((source (current-buffer))
             (state (my/excali-test--conversion-state))
             (doc excali--doc) (elements excali--elements)
             (selection excali--selection) (style excali--current-style)
             (preset my/excali--current-preset) (cache excali--native-cache)
             (undo excali--undo-stack) (redo excali--redo-stack)
             (history (copy-tree (list excali--undo-stack excali--redo-stack) t))
             (frozen excali--frozen) (themes custom-enabled-themes)
             disposable)
         (cl-letf (((symbol-function 'excali-export-png)
                    (lambda (file selection-only)
                      (setq disposable (current-buffer))
                      (should-not (eq disposable source))
                      (should (equal file (expand-file-name "export.png")))
                      (should selection-only)
                      (should (equal (alist-get 'palette excali--doc)
                                     (my/excali--read-palette "doric-light")))
                      (should (equal (mapcar (lambda (e) (excali--get e 'id)) excali--selection)
                                     '("box")))
                      (should (memq (car excali--selection) excali--elements))
                      (should-not (eq excali--native-cache cache))
                      (should (= excali-export-scale 2))
                      (should (= excali-export-padding 23))
                      (should-not excali-export-background)
                      (should-not excali-export-embed-scene)
                      (pcase outcome
                        ('error (error "Export failed"))
                        ('quit (signal 'quit nil))
                        (_ file))))
                   ((symbol-function 'load-theme) (lambda (&rest _) (ert-fail "Theme changed")))
                   ((symbol-function 'excali-save) (lambda () (ert-fail "Source saved"))))
           (pcase outcome
             ('error (should-error (my/excali-export "export.png" t)))
             ('quit (should (eq (condition-case nil (my/excali-export "export.png" t)
                                  (quit :cancelled)) :cancelled)))
             (_ (should (equal (my/excali-export "export.png" t)
                               (expand-file-name "export.png"))))))
         (should-not (buffer-live-p disposable))
         (should (eq (current-buffer) source))
         (should (equal state (my/excali-test--conversion-state)))
         (should (eq doc excali--doc))
         (should (eq elements excali--elements))
         (should (eq selection excali--selection))
         (should (eq style excali--current-style))
         (should (eq preset my/excali--current-preset))
         (should (eq cache excali--native-cache))
         (should (eq undo excali--undo-stack))
         (should (eq redo excali--redo-stack))
         (should (equal history (list excali--undo-stack excali--redo-stack)))
         (should (eq frozen excali--frozen))
         (should (eq themes custom-enabled-themes))
         (should (eq modified (buffer-modified-p))))))))

(ert-deftest my/excali-export-interactive-uses-native-png-prompt-and-selection ()
