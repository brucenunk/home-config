(defun my/excali-test--conversion-state ()
  "Return conversion state without native edit timestamps/nonces."
  (list (copy-tree excali--doc t)
        (mapcar (lambda (element)
                  (seq-remove (lambda (pair) (memq (car pair) '(version versionNonce updated)))
                              (copy-tree element t)))
                excali--elements)
        (copy-tree excali--current-style t) (copy-tree my/excali--current-preset t)))

(ert-deftest my/excali-preview-repeats-from-original-and-cancel-preserves-redo ()
  (require 'consult)
  (dolist (modified '(nil t))
    (my/excali-test--conversion-scene
     (my/excali-use-preset 'accented)
     (excali-undo)
     (set-buffer-modified-p modified)
     (let* ((before (my/excali-test--conversion-state))
            (earth (let ((excali--doc (copy-tree excali--doc t))
                         (excali--elements (copy-tree excali--elements t))
                         (excali--current-style (copy-tree excali--current-style t))
                         (my/excali--current-preset (copy-tree my/excali--current-preset t))
                         (excali--native-cache (make-hash-table :test #'eq))
                         (excali--history-hold t))
                     (my/excali-update-palette "doric-earth")
                     (my/excali-test--conversion-state)))
            (doc excali--doc) (elements excali--elements)
            (style excali--current-style) (preset my/excali--current-preset)
            (selection excali--selection) (cache excali--native-cache)
            (undo excali--undo-stack) (redo excali--redo-stack)
            (frozen excali--frozen) (frozen-values (copy-hash-table frozen))
            (excali-history-limit 1)
            (renders 0) painted)
       (set-buffer-modified-p modified)
       (cl-letf (((symbol-function 'consult--read)
                  (lambda (_names &rest options)
                    (should (eq (plist-get options :preview-key) 'any))
                    (let ((lookup (plist-get options :lookup)))
                      (should (equal (funcall lookup "doric-obsidian") "doric-obsidian"))
                      (should-not (funcall lookup "d"))
                      (should-not (funcall lookup "uninstalled")))
                    (should (eq (plist-get options :category) 'theme))
                    (should (plist-get options :sort))
                    (let ((state (plist-get options :state)) first)
                      (funcall state 'setup nil)
                      (funcall state 'preview "doric-obsidian")
                      (setq first painted)
                      (should-not (equal first before))
                      ;; Preview pixels persist, but input always sees the real
                      ;; objects, defaults, modified flag and history.
                      (should (eq elements excali--elements))
                      (should (eq doc excali--doc))
                      (should (eq selection excali--selection))
                      (should (eq modified (buffer-modified-p)))
                      ;; A native redraw must paint the same preview without
                      ;; needing another candidate change from Consult.
                      (excali--render 'full)
                      (should (equal first painted))
                      (should (eq elements excali--elements))
                      (funcall state 'preview "doric-earth")
                      ;; Exact source styling must survive a round trip through
                      ;; a palette which can merge previously distinct inks.
                      (should (equal earth painted))
                      (funcall state 'preview "doric-obsidian")
                      (should (equal first painted))
                      (should (eq undo excali--undo-stack))
                      (should (eq redo excali--redo-stack))
                      (funcall state 'preview nil)
                      (funcall state 'exit nil)
                      (funcall state 'return nil)
                      (signal 'quit nil))))
                 ((symbol-function 'excali--render)
                  (lambda (&rest _)
                    (cl-incf renders)
                    (when excali--history-hold
                      (should (memq (car excali--selection) excali--elements))
                      (should-not (memq (car excali--selection) elements))
                      (setq painted (my/excali-test--conversion-state))))))
         (should (eq (condition-case nil (call-interactively #'my/excali-update-palette)
                       (quit :cancelled)) :cancelled)))
       (should (= renders 5))
       (should (equal before (my/excali-test--conversion-state)))
       (should (eq doc excali--doc))
       (should (eq elements excali--elements))
       (should (eq selection excali--selection))
       (should (eq style excali--current-style))
       (should (eq preset my/excali--current-preset))
       (should (eq cache excali--native-cache))
       (should (eq undo excali--undo-stack))
       (should (eq redo excali--redo-stack))
       (should (eq frozen excali--frozen))
       (should (= (hash-table-count frozen) (hash-table-count frozen-values)))
       (maphash (lambda (key value) (should (eq value (gethash key frozen)))) frozen-values)
       (should (eq modified (buffer-modified-p)))
       (should-not excali--history-hold)
       (excali-redo)
       (should (eq (my/excali--shown-preset) 'accented))
       (excali-undo)
       (should (equal (nth 1 before) (nth 1 (my/excali-test--conversion-state))))))))

(ert-deftest my/excali-preview-unwinds-on-reader-and-converter-errors ()
  (require 'consult)
  (dolist (failure '(quit reader-error invalid-target render-error))
