(defmacro my/excali-test--org-scene (&rest body)
  "Run BODY in an Org buffer referencing a saved, unopened scene."
  `(let* ((directory (make-temp-file "excali-org-" t))
          (source (expand-file-name "diagrams/scene.excalidraw" directory))
          (my/excali-preview-directory (expand-file-name "cache/" directory))
          (my/excali-palette-directory my/excali-test--palette-directory))
     (unwind-protect
         (progn
           (make-directory (file-name-directory source) t)
           (make-directory (expand-file-name "docs/" directory))
           (my/excali-test--conversion-scene
            (push (excali--make-element
                   "rectangle" 0 400 '(id . "backplate")
                   '(width . 150) '(height . 30)
                   '(strokeColor . "transparent") '(fillStyle . "solid")
                   `(backgroundColor . ,(alist-get 'canvas (alist-get 'palette excali--doc))))
                  excali--elements)
            (let ((text (excali--serialize-doc excali--doc excali--elements)))
              (with-temp-file source (insert text))))
           (with-temp-buffer
             (setq buffer-file-name (expand-file-name "docs/page.org" directory))
             (insert "[[excali:../diagrams/scene.excalidraw]]\n")
             (org-mode)
             ,@body))
       (delete-directory directory t))))

(ert-deftest my/excali-org-relative-completion-and-follow ()
  (require 'org)
  (my/excali-test--org-scene
   (let ((default-directory temporary-file-directory)
         (my/excali-directory (file-name-directory source))
         opened)
     (cl-letf (((symbol-function 'read-file-name)
                (lambda (_prompt dir _default mustmatch _initial predicate)
                  (should (equal dir my/excali-directory))
                  (should mustmatch)
                  (should (funcall predicate source))
                  (should-not (funcall predicate "not-a-scene.txt"))
                  source))
               ((symbol-function 'my/excali-open) (lambda (file) (setq opened file))))
       (should (equal (my/excali--org-complete) "excali:../diagrams/scene.excalidraw"))
       (my/excali--org-follow "../diagrams/scene.excalidraw" nil)
       (should (equal opened source))
       (let ((indirect (make-indirect-buffer (current-buffer) " *org-indirect-test*" t)))
         (unwind-protect
             (with-current-buffer indirect
               (should-not buffer-file-name)
               (should (equal (my/excali--org-source "../diagrams/scene.excalidraw") source))
               (should (equal (my/excali--org-complete)
                              "excali:../diagrams/scene.excalidraw"))
               (my/excali--org-follow "../diagrams/scene.excalidraw" nil)
               (should (equal opened source)))
           (kill-buffer indirect))))
     (should-error (my/excali--org-source "missing.excalidraw") :type 'user-error)
     (let ((buffer-file-name nil))
       (should-error (my/excali--org-complete) :type 'user-error)))))

(ert-deftest my/excali-org-real-render-cache-and-publication ()
  (require 'org)
  (require 'ox-html)
  (require 'ox-latex)
  (my/excali-test--org-scene
   (let* ((custom-enabled-themes '(doric-earth))
          (before (with-temp-buffer (insert-file-contents source) (buffer-string)))
          (render (symbol-function 'excali-export-png))
          (count 0) snapshots earth dark light)
     (should-not (get-file-buffer source))
     (cl-letf (((symbol-function 'excali-export-png)
                (lambda (&rest args)
                  (cl-incf count)
                  (push (copy-tree (list excali--doc excali--elements) t) snapshots)
                  (apply render args))))
       (setq earth (my/excali--org-image "../diagrams/scene.excalidraw" nil))
       (should (equal earth (my/excali--org-image "../diagrams/scene.excalidraw" nil)))
       (should (= count 1))
       (let ((custom-enabled-themes '(doric-obsidian)))
         (setq dark (my/excali--org-image "../diagrams/scene.excalidraw" nil))
         (setq light (my/excali--org-image "../diagrams/scene.excalidraw" t)))
       (should-not (equal earth dark))
       (should (equal light (my/excali--org-image "../diagrams/scene.excalidraw" t)))
       (should (= count 3))
       (dolist (snapshot snapshots)
         (pcase-let* ((`(,doc ,elements) snapshot)
                      (palette (alist-get 'palette doc))
                      (box (seq-find (lambda (e) (equal (alist-get 'id e) "box")) elements))
                      (fixed (seq-find (lambda (e) (equal (alist-get 'id e) "fixed")) elements))
                      (label (seq-find (lambda (e) (equal (alist-get 'id e) "label")) elements))
                      (backplate (seq-find (lambda (e) (equal (alist-get 'id e) "backplate")) elements)))
           (should (equal (alist-get 'viewBackgroundColor (alist-get 'appState doc))
                          (alist-get 'canvas palette)))
           (should (equal (alist-get 'backgroundColor box)
                          (alist-get 'fill (alist-get 'neutral (alist-get 'presets palette)))))
           (should (equal (alist-get 'strokeColor fixed) "#ff0000"))
           (should (equal (alist-get 'backgroundColor backplate) (alist-get 'canvas palette)))
           (should (equal (alist-get 'strokeColor label)
                          (my/excali--text-color
                           (alist-get 'text (alist-get 'neutral (alist-get 'presets palette)))
                           (alist-get 'backgroundColor box))))))
       (dolist (file (list earth dark light))
         (should (equal (substring (excali--read-image-file file) 0 8)
                        (unibyte-string 137 80 78 71 13 10 26 10))))
       (let ((custom-enabled-themes '(doric-obsidian)))
         (should (string-match-p (regexp-quote (file-name-nondirectory light))
                                 (org-export-as 'html nil nil t)))
         (should (string-match-p "<img " (org-export-as 'html nil nil t)))
         (should (string-match-p "includegraphics" (org-export-as 'latex nil nil t))))
       (should-error (org-export-as 'ascii nil nil t) :type 'user-error)
       (should (equal before (with-temp-buffer (insert-file-contents source) (buffer-string))))
       (should-not (get-file-buffer source))
       ;; Same path, changed saved content: no stale image reuse.
       (with-temp-file source (insert (replace-regexp-in-string "box" "box-new" before)))
       (should-not (equal earth (my/excali--org-image "../diagrams/scene.excalidraw" nil)))))))

(ert-deftest my/excali-org-displayed-previews-refresh-on-save-and-theme ()
  (require 'org)
  (my/excali-test--org-scene
   (let ((custom-enabled-themes '(doric-earth))
         (org-link-preview-batch-size 100)
         (org-buffer (current-buffer)))
     ;; Keep native PNG rendering and Org overlay logic; batch has no GUI frame.
     (cl-letf (((symbol-function 'display-graphic-p) (lambda (&rest _) t))
               ((symbol-function 'create-image)
                (lambda (file &rest _) (list 'image :type 'png :file file)))
               ((symbol-function 'image-flush) #'ignore))
       (my/excali--org-display)
       (should (= (length org-link-preview-overlays) 1))
       (let* ((ov (car org-link-preview-overlays))
              (earth (overlay-get ov 'display)) dark saved)
         (should (eq (car earth) 'image))
         (should (equal (overlay-get ov 'my-excali-source) source))
         (let ((custom-enabled-themes '(doric-obsidian)))
           (run-hook-with-args 'enable-theme-functions 'doric-obsidian)
           (setq dark (overlay-get (car org-link-preview-overlays) 'display)))
         (should-not (equal earth dark))
         (my/excali-test--conversion-scene
          (setq excali--file source)
          (excali--set-element-style (car excali--elements) 'x 123)
          (excali-save))
         (with-current-buffer org-buffer
           (setq saved (overlay-get (car org-link-preview-overlays) 'display)))
         (should-not (equal earth saved))
         ;; Explicit refresh reuses the file but installs/flushed a fresh image.
         (org-link-preview-refresh)
         (should (equal saved (overlay-get (car org-link-preview-overlays) 'display)))
         (delete-file source)
         (org-link-preview-refresh)
         (should-not org-link-preview-overlays))))))

