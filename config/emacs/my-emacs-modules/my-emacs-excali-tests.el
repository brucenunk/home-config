    ,@body))

(ert-deftest my/excali-automatic-following-matches-conservative-conversion ()
  (my/excali-test--conversion-scene
   (let* (selection
          (before (my/excali-test--conversion-state))
          expected)
     ;; Compare the hook path with the established explicit converter.
     (my/excali-update-palette "doric-obsidian")
     (setq expected (my/excali-test--conversion-state)
           excali--doc (nth 0 before)
           excali--elements (nth 1 before)
           excali--current-style (nth 2 before)
           my/excali--current-preset (nth 3 before)
           excali--selection (list (nth 4 excali--elements)))
     (setq selection excali--selection)
     (excali--history-reset)
     (set-buffer-modified-p nil)
     (let ((custom-enabled-themes '(doric-obsidian)))
       (run-hook-with-args 'enable-theme-functions 'doric-obsidian))
     (should (equal expected (my/excali-test--conversion-state)))
     (should (equal (my/excali--read-palette "doric-obsidian")
                    (alist-get 'palette excali--doc)))
     (should (equal (nth 5 (nth 1 before)) (nth 5 excali--elements)))
     (should (eq selection excali--selection))
     (should (buffer-modified-p))
     (should (= (length excali--undo-stack) 2)))))

