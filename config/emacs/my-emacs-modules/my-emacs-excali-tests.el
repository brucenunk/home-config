                     excali--doc (copy-tree (buffer-local-value 'excali--doc scene) t)
                     excali--elements (copy-tree (buffer-local-value 'excali--elements scene) t)
                     excali--current-style (copy-tree (buffer-local-value 'excali--current-style scene) t)
                     excali--native-cache (make-hash-table :test #'eq))
               (excali--history-reset)))
           (with-current-buffer bad
             (setf (alist-get 'palette excali--doc) 'malformed))
           (with-current-buffer other
             (set-buffer-modified-p nil))
           ;; Force the bad scene first; do not let its failure hide later work.
           (cl-letf (((symbol-function 'buffer-list) (lambda (&rest _) (list bad hidden other scene)))
                     ((symbol-function 'excali-save) (lambda () (ert-fail "Automatic save"))))
             (run-hook-with-args 'enable-theme-functions 'doric-obsidian))
           (should (eq (current-buffer) scene))
           (dolist (buffer (list hidden scene))
             (with-current-buffer buffer
               (should (equal target (alist-get 'palette excali--doc)))
               (should (equal (excali--canvas-color) (alist-get 'canvas target)))
               (should (buffer-modified-p))))
           (with-current-buffer other (should-not (buffer-modified-p))))
       (dolist (buffer (list bad hidden other))
         (with-current-buffer buffer (set-buffer-modified-p nil))
         (kill-buffer buffer))))))

