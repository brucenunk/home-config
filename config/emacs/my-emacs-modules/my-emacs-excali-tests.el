       (cl-letf (((symbol-function 'consult--read)
                  (lambda (_names &rest options)
                    (let ((state (plist-get options :state)))
                      (funcall state 'preview "doric-obsidian")
                      (pcase failure
                        ('quit (signal 'quit nil))
                        ('reader-error (error "Reader failed"))
                        ('invalid-target (funcall state 'preview "missing-palette"))
                        ('render-error
                         (cl-letf (((symbol-function 'excali--render)
                                    (lambda (&rest _) (error "Render failed"))))
                           (funcall state 'preview "doric-earth"))))))))
         (should (eq (condition-case nil (call-interactively #'my/excali-update-palette)
                       ((error quit) :failed)) :failed)))
       (should (equal before (my/excali-test--conversion-state)))
       (should (eq elements excali--elements))
       (should (eq selection excali--selection))
       (should (eq undo excali--undo-stack))
       (should (eq render (symbol-function 'excali--render)))
       (should-not excali--history-hold)
       (should-not (buffer-modified-p))))))

(ert-deftest my/excali-preview-accepts-one-normal-conversion-and-roundtrips ()
  (require 'consult)
  (let ((file (make-temp-file "excali-preview-" nil ".excalidraw")))
    (unwind-protect
        (my/excali-test--conversion-scene
         (excali--history-reset)
         (excali--set-element-style (car excali--elements) 'strokeColor "#123456")
         (excali--commit)
         (excali-undo)
         (should excali--redo-stack)
         (let ((before (copy-tree excali--elements t))
               (before-state (my/excali-test--conversion-state))
               (original excali--elements) (selection excali--selection)
               (initial (copy-tree (alist-get 'palette excali--doc) t))
               (commits 0)
               (commit (symbol-function 'excali--commit)))
           (cl-letf (((symbol-function 'excali--commit)
                      (lambda ()
                        (unless excali--history-hold
                          (should (eq excali--elements original))
                          (cl-incf commits))
                        (funcall commit)))
                     ((symbol-function 'consult--read)
                      (lambda (_names &rest options)
                        (let ((state (plist-get options :state)))
                          (funcall state 'preview "doric-obsidian")
                          (funcall state 'preview "doric-earth")
                          (funcall state 'preview nil)
                          (funcall state 'exit nil)
                          (funcall state 'return "doric-obsidian")
                          "doric-obsidian"))))
             (call-interactively #'my/excali-update-palette))
           (should (= commits 1))
           (should (= (length excali--undo-stack) 2))
           (should-not excali--redo-stack)
           (should (eq selection excali--selection))
           (should (buffer-modified-p))
           (let ((after (copy-tree excali--elements t))
                 (state (my/excali-test--conversion-state)))
             (excali-undo)
             (should (equal before excali--elements))
             (should (equal before-state (my/excali-test--conversion-state)))
             (excali-redo)
             (should (equal after excali--elements))
             (setq excali--file file)
             (excali-save)
             (my/excali-test--opening
              (let ((custom-enabled-themes '(doric-obsidian))) (excali-open file))
              (dolist (key '(palette customData))
                (should (equal (alist-get key (car state)) (alist-get key excali--doc))))
              (should (equal (alist-get 'viewBackgroundColor (alist-get 'appState (car state)))
                             (excali--canvas-color)))
              (cl-mapc
               (lambda (saved reopened)
                 ;; Native restore normalises structure and adds defaults;
                 ;; compare the conversion's persisted styling and metadata.
                 (dolist (key '(id type strokeColor backgroundColor fillStyle customData))
                   (should (equal (alist-get key saved) (alist-get key reopened)))))
               after excali--elements)
              (should-not my/excali--current-preset)
              (my/excali-update-palette "doric-earth")
              (should (equal initial (alist-get 'palette excali--doc)))))))
      (delete-file file))))

(ert-deftest my/excali-graphical-automatic-preview-resize-and-cancel ()
  (skip-unless (display-graphic-p))
  (require 'consult)
  (require 'vertico)
  (let ((my/excali-palette-directory my/excali-test--palette-directory)
        (custom-enabled-themes '(doric-earth))
        (vertico-was-enabled vertico-mode)
        buffer painted moved resized)
    (save-window-excursion
      (unwind-protect
          (progn
            (vertico-mode 1)
            (excali-new)
            (setq buffer (current-buffer)
                  excali--elements (list (excali--make-element "rectangle" 10 10
                                          '(width . 100) '(height . 80)))
                  excali--selection excali--elements)
            (my/excali-use-preset 'neutral)
            (set-buffer-modified-p nil)
            (let ((before (my/excali-test--conversion-state))
                  (elements excali--elements) (undo excali--undo-stack)
                  (render (symbol-function 'excali--render)))
              (cl-letf (((symbol-function 'excali--render)
                         (lambda (&rest args)
                           (apply render args)
                           (when (eq (current-buffer) buffer)
                             (push (cons (excali--canvas-color)
                                         (plist-get excali--last-stats :drawn)) painted)))))
                (should
                 (eq (condition-case nil
                         (minibuffer-with-setup-hook
                             (lambda ()
                               ;; Force completion updates despite synthetic
                               ;; queued input, which Vertico can defer.
                               (local-set-key (kbd "<f8>")
                                              (lambda () (interactive) (vertico--update)))
                               (local-set-key
                                (kbd "<f7>")
                                (lambda ()
                                  (interactive)
                                  (let* ((name (vertico--candidate))
                                         (canvas (alist-get 'canvas (my/excali--read-palette name))))
                                    (should-not (equal name "doric-earth"))
                                    (with-selected-window (minibuffer-selected-window)
                                      (should (equal (car (last excali--rendered-key)) canvas)))
                                    (setq moved t))))
                               (local-set-key
                                (kbd "<f6>")
                                (lambda ()
                                  (interactive)
                                  (with-selected-window (minibuffer-selected-window)
                                    (let ((canvas (alist-get 'canvas (my/excali--read-palette "doric-earth"))))
                                      (dolist (window (excali--view-windows))
                                        (should (equal (car (last (excali--view-value window 'excali--rendered-key)))
                                                       canvas)))))))
                               (local-set-key
                                (kbd "<f9>")
                                (lambda ()
                                  (interactive)
                                  (with-selected-window (minibuffer-selected-window)
                                    (should (eq elements excali--elements))
                                    (should (equal (car excali--rendered-key)
                                                   excali--fb))
                                    (let ((target (alist-get 'canvas
                                                  (my/excali--read-palette "doric-obsidian"))))
                                      ;; Moving the highlighted candidate, not a
                                      ;; preview key, must already have painted it.
                                      (should (equal (car (last excali--rendered-key)) target))
                                      (unless resized (split-window-right))
                                      (excali--window-size-change (selected-frame))
                                      (should (equal (car (last excali--rendered-key)) target))
                                      (setq resized t)))))
                               (setq unread-command-events
                                     (listify-key-sequence
                                      (kbd (concat "<f8> <down> <f7> doric-obsidian <f8> <f9> "
                                                   "C-a C-k doric-earth <f8> <f6> "
                                                   "C-a C-k doric-obsidian <f8> <f9> C-g")))))
                           (call-interactively #'my/excali-update-palette))
                       (quit :cancelled)) :cancelled)))
              (should moved)
              (should resized)
              (let ((canvas (alist-get 'canvas (my/excali--read-palette "doric-earth"))))
                (dolist (window (excali--view-windows))
                  (should (equal (car (last (excali--view-value window 'excali--rendered-key))) canvas))))
              (should (member (alist-get 'canvas (my/excali--read-palette "doric-obsidian"))
                              (mapcar #'car painted)))
              (should (equal (caar painted) (alist-get 'canvas (my/excali--read-palette "doric-earth"))))
              (should (cl-some (lambda (frame) (> (cdr frame) 0)) painted))
              (should (equal before (my/excali-test--conversion-state)))
              (should (eq elements excali--elements))
              (should (eq undo excali--undo-stack))
              (should-not (buffer-modified-p))))
        (vertico-mode (if vertico-was-enabled 1 -1))
        (when (buffer-live-p buffer)
          (with-current-buffer buffer (set-buffer-modified-p nil))
          (kill-buffer buffer))))))

