               (lambda (task-id)
                 (should (equal task-id "20260324T103418"))
                 (list :task-id task-id :worktree "/tmp/a/")))
              ((symbol-function 'denote-retrieve-title-value)
               (lambda (&rest _)
                 "Review lisp"))
              ((symbol-function 'denote-filetype-heuristics)
               (lambda (&rest _)
                 'markdown-yaml))
