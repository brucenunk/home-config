(ert-deftest my/task-file-falls-back-across-shared-task-root ()
  (let* ((temp-root (make-temp-file "my-task-shared-root" t))
         (tasks-root (expand-file-name "tasks/" temp-root))
         (epic-dir (expand-file-name "session-bugs/" tasks-root))
         (task-id "20260324T103418")
         (task-file (expand-file-name
                     (format "%s==todo--shared-root.md" task-id)
                     epic-dir))
         (my/task--file-cache (make-hash-table :test 'equal)))
    (make-directory epic-dir t)
    (unwind-protect
        (progn
          (with-temp-file task-file
            (insert "---\n---\n"))
          (cl-letf (((symbol-function 'my/task--task-directories)
                     (lambda ()
                       (list tasks-root)))
                    ((symbol-function 'denote-get-path-by-id) (lambda (_id) nil))
                    ((symbol-function 'denote-retrieve-filename-signature)
                     (lambda (file)
                       (should (equal file task-file))
                       "todo")))
            (let ((denote-directory tasks-root))
              (should (equal (my/task-file task-id) task-file))
              (should (equal (my/task-status task-id) "todo")))))
      (delete-directory temp-root t))))

(ert-deftest my/task-file-caches-cross-owner-fallback-hit ()
  (let* ((temp-file (make-temp-file "my-task-cache"))
         (task-id "20260324T103418")
         (my/task--file-cache (make-hash-table :test 'equal))
         (search-calls 0))
    (unwind-protect
        (cl-letf (((symbol-function 'denote-get-path-by-id)
                   (lambda (_task-id)
                     nil))
                  ((symbol-function 'my/task--find-file-in-task-directories)
                   (lambda (id)
                     (should (equal id task-id))
                     (setq search-calls (1+ search-calls))
                     temp-file)))
          (should (equal (my/task-file task-id) temp-file))
          (should (equal (my/task-file task-id) temp-file))
          (should (= search-calls 1)))
      (delete-file temp-file t))))

