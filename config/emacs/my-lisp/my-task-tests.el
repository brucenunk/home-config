(ert-deftest my/git-in-merge-or-rebase-p-resolves-linked-worktree-git-dir ()
  (require 'my-git)
  (let ((git-dir (make-temp-file "my-git-dir" t)))
    (unwind-protect
        (progn
          (with-temp-file (expand-file-name "MERGE_HEAD" git-dir)
            (insert "merge"))
          (cl-letf (((symbol-function 'my/git-run-in-dir)
                     (lambda (_dir &rest _args)
                       (cons 0 (concat git-dir "\n")))))
            (should (my/git-in-merge-or-rebase-p "/tmp/worktree"))))
      (delete-directory git-dir t))))

(ert-deftest my/task-startup-recover-index-async-backfills-live-attached-worktrees ()
  (my/task-index-test--with-isolated-index
    (let ((callback-result :unset)
          (notifications nil)
          (my/task--startup-recovery-running nil)
          (my/task--startup-recovery-callbacks nil))
      (my/task-index-put "20260324T103419" (list :worktree "/tmp/reused/"))
      (cl-letf (((symbol-function 'run-with-idle-timer)
                 (lambda (_secs _repeat fn &rest _args)
                   (funcall fn)
                   'timer))
                ((symbol-function 'file-directory-p)
                 (lambda (path)
                   (member path '("/tmp/a/" "/tmp/reused/"))))
                ((symbol-function 'my/git-branch)
                 (lambda (path)
                   (pcase path
                     ("/tmp/a/" "jamesl-20260324T103418")
                     ("/tmp/reused/" "jamesl-20260324T999999"))))
                ((symbol-function 'my/task-todo-list)
                 (lambda ()
                   '("/tmp/20260324T103418==todo--task.md")))
                ((symbol-function 'my/task--live-worktree-table)
                 (lambda (_task-files)
                   (let ((table (make-hash-table :test 'equal)))
                     (puthash "20260324T103418" "/tmp/a/" table)
                     table)))
                ((symbol-function 'my/task-state-notify)
                 (lambda (task-id source &rest props)
                   (push (append (list :task-id task-id :source source) props)
                         notifications))))
        (my/task-startup-recover-index-async
         :on-complete (lambda (result)
                        (setq callback-result result)))
        (should (equal (my/task-index-worktree "20260324T103418")
                       "/tmp/a/"))
        (should-not (my/task-index-worktree "20260324T103419"))
        (should (equal callback-result
                       '(:recovered ("20260324T103419" "20260324T103418") :failed nil)))
        (should (= (length notifications) 2))
        (should-not my/task--startup-recovery-running)
        (should-not my/task--startup-recovery-callbacks)))))

