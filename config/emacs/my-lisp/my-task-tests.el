(ert-deftest my/task-session-set-and-clear-update-front-matter ()
  (let ((task-file (make-temp-file "my-task-session-front-matter" nil ".md")))
    (unwind-protect
        (progn
          (with-temp-file task-file
            (insert "---\n"
                    "title:        \"Task\"\n"
                    "repo:        brucenunk/home-config\n"
                    "---\n\n"
                    "body\n"))
          (my/task-session-set task-file "pi:20260422T031929929Z")
          (my/task-note-worktree-set task-file "c")
          (should (equal (my/task-session-get task-file)
                         "pi:20260422T031929929Z"))
          (should (equal (my/task-note-worktree-get task-file)
                         "c"))
          (with-temp-buffer
            (insert-file-contents task-file)
            (goto-char (point-min))
            (should (search-forward "session:        pi:20260422T031929929Z" nil t))
            (goto-char (point-min))
            (should (search-forward "worktree:        c" nil t))
            (goto-char (point-min))
            (should (search-forward "repo:        brucenunk/home-config" nil t)))
          (my/task-session-clear task-file)
          (should-not (my/task-session-get task-file))
          (should-not (my/task-note-worktree-get task-file))
          (with-temp-buffer
            (insert-file-contents task-file)
            (goto-char (point-min))
            (should-not (search-forward "session:" nil t))
            (should-not (search-forward "worktree:" nil t))
            (should (search-forward "repo:        brucenunk/home-config" nil t))))
      (delete-file task-file t))))

