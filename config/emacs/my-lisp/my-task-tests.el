(ert-deftest my/task-state-entries-copies-indexed-state-without-repair ()
  (let ((entry (my/task-index-test--entry
                "20260324T103418"
                :worktree "/tmp/a/"
                :active t))
        repair-called)
    (cl-letf (((symbol-function 'my/task-startup-recover-index-async)
               (lambda (&rest _args)
                 nil))
              ((symbol-function 'my/task--repair-index)
               (lambda ()
                 (setq repair-called t)
                 (ert-fail "UI snapshot read should not run global repair")))
              ((symbol-function 'my/task-index-entries)
               (lambda ()
                 (list entry))))
      (let* ((result (my/task-state-entries))
             (result-entry (car result)))
        (should-not repair-called)
        (should (equal result-entry entry))
        (setf (plist-get result-entry :worktree) "/tmp/changed/")
        (should (equal (plist-get entry :worktree) "/tmp/a/"))))))

