;;; my-agent-catalogue.el --- Generated agent configuration -*- lexical-binding: t -*-

;; Author: James Lee
;; URL: https://github.com/brucenunk/home-config
;; Version: 0.1.0
;; Package-Requires: ((emacs "30.1"))

;;; Commentary:

;; Public commands:
;;   - my/agent-catalogue-reload — load the trusted generated configuration
;; `my/agent-machines' holds the configured machines and agent capabilities.
;; init.el loads agent-catalogue.el once; reload explicitly after activating a
;; new generation.  This is executable configuration, not imported task data.
;; Loading it does not probe hosts, query Git, or launch sessions.

;;; Code:

(defvar my/agent-machines nil
  "Configured machines and agent capabilities, generated by Nix.
An alist with string machine names as keys and record plists as values:

  ((\"machine\" :directory \"~/work/\"
    :repositories ((:name \"owner/repo\" :path \"/work/repo.git\"
                    :base-ref \"origin/main\"))
    :default-model \"provider/model\"
    :models ((:name \"provider/model\" :thinking-levels (\"off\" \"medium\")
              :default-thinking \"medium\"))))

Directories include the connection when remote, preferably RPC TRAMP syntax.
Repository paths are absolute and machine-local, with no TRAMP prefix; they
may name ordinary worktrees or bare Git directories.  Model references split
at the first slash only.  An empty model default means no configured models;
an empty thinking default requires an explicit choice.  No local-machine
identity, provider endpoints, or credentials are projected here.

The trusted agent-catalogue.el in `user-emacs-directory' sets this variable
at startup.  Structural correctness belongs to Nix options and generation
tests, not a duplicate Lisp schema.  Capture uses this loaded value, not a
fresh disk read; use `my/agent-catalogue-reload' after configuration changes.
These are configured choices, not readiness or authorization evidence.")

;;;###autoload
(defun my/agent-catalogue-reload (&optional noerror)
  "Load the trusted generated agent-catalogue.el as executable configuration.
Clear the previous inventory first, so a missing file cannot retain old
choices.  With NOERROR, allow a missing file, as at startup.  Other load errors
propagate normally.  After activation, run this command or restart Emacs to
pick up the new configuration; capture does not reload it automatically."
  (interactive)
  (setq my/agent-machines nil)
  (load (locate-user-emacs-file "agent-catalogue.el") noerror t t))

(provide 'my-agent-catalogue)
;;; my-agent-catalogue.el ends here
