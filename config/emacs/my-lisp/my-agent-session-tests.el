(ert-deftest my/agent-session-naming-collisions ()
  (my/agent-session-test--repository
    (let* ((context (my/agent-session-test--context :source source :prompt "task" :title "Long task title")))
      (cl-letf (((symbol-function 'float-time) (lambda (&optional _) 36)))
        (my/agent-session--git source "branch" "long-task-title-10")
        (make-directory (expand-file-name "../long-task-title-10-1" source))
        (make-symbolic-link "missing" (expand-file-name "../long-task-title-10-2" source))
        (my/agent-session--name context)
        (should (equal (plist-get context :branch) "long-task-title-10-3"))
        (should (equal (plist-get context :directory)
                       (expand-file-name "../long-task-title-10-3/" source)))
        (setf (plist-get context :prompt) nil)
        (my/agent-session--name context)
        (should (equal (plist-get context :branch) "adhoc-10"))))))

(ert-deftest my/agent-session-slug-bounds ()
  (should (equal (my/agent-session--base36 0) "0"))
  (should (equal (my/agent-session--base36 1295) "zz"))
  (should (equal (my/agent-session--slug "Hello, WORLD! ☃") "hello-world"))
  (should (equal (my/agent-session--slug "☃") "task"))
  (should (<= (length (my/agent-session--slug (make-string 80 ?x))) 40))
  (should (equal (my/agent-session--slug (concat (make-string 35 ?x) "-abcdefghi")) (make-string 35 ?x))))

(ert-deftest my/agent-session-git-bare-linked-and-fetch ()
  (my/agent-session-test--repository
    (let* ((bare (expand-file-name "repo space/master.git" root))
           (linked (expand-file-name "repo space/linked" root))
           (commit (my/agent-session--base-resolve source "main")))
      (my/agent-session--git root "clone" "--bare" source bare)
      (my/agent-session--git source "remote" "add" "origin" bare)
      (should (equal commit (my/agent-session--base-resolve source "origin/main")))
      (should (equal commit (my/agent-session--base-resolve source "refs/remotes/origin/main")))
      (my/agent-session--git source "branch" "train/part-two")
      (should (equal commit (my/agent-session--base-resolve source "train/part-two")))
      (dolist (invalid '("--help" "main~1" "refs/tags/missing" "origin/--bad" "missing"))
        (should-error (my/agent-session--base-resolve source invalid)))
      (my/agent-session--git source "worktree" "add" "-b" "linked" linked "main")
      (dolist (git-source (list source bare linked))
        (let ((context (my/agent-session-test--context :source git-source)))
          (my/agent-session--name context)
          (should (equal (file-name-directory (directory-file-name (plist-get context :directory)))
                         (file-name-directory (directory-file-name source))))
          (my/agent-session--git git-source "worktree" "add" "--no-track" "-b"
                                 (plist-get context :branch) "--" (plist-get context :directory) commit)
          (should (equal commit (my/agent-session--git (plist-get context :directory) "rev-parse" "HEAD")))))
      (should (equal (my/agent-session--git source "branch" "--show-current") "main")))))

(ert-deftest my/agent-session-remote-paths-and-git-boundary ()
  (let ((source "/rpc:user@host#22:/srv/repo/master.git/") calls)
    (cl-letf (((symbol-function 'my/agent-session--git-result)
               (lambda (dir &rest args) (push (cons dir args) calls) '(1 . "")))
              ((symbol-function 'file-exists-p) (lambda (_) nil))
              ((symbol-function 'file-symlink-p) (lambda (_) nil)))
      (let ((context (my/agent-session-test--context :source source)))
        (my/agent-session--name context)
        (should (string-prefix-p "/rpc:user@host#22:/srv/repo/adhoc-" (plist-get context :directory)))
        (should (equal (caar calls) source))
        (should (string-prefix-p "/srv/repo/adhoc-" (file-local-name (plist-get context :directory))))))
    (cl-letf (((symbol-function 'process-file)
               (lambda (program infile destination display &rest args)
                 (should (equal program "git")) (should-not infile) (should-not display)
                 (should (equal default-directory source))
                 (should (equal args '("rev-parse" "HEAD")))
                 (with-current-buffer (car destination) (insert "commit\n")) 0)))
      (should (equal (my/agent-session--git source "rev-parse" "HEAD") "commit")))))

(ert-deftest my/agent-session-selection-and-cancellation ()
  (let ((my/agent-machines
         '(("a" :directory "/local/" :repositories ((:name "owner/repo" :path "/srv/repo/main" :base-ref "origin/main")))
           ("b" :directory "/rpc:host:/browse/" :repositories ((:name "owner/repo" :path "/srv/repo/master.git" :base-ref "origin/master"))))))
    (cl-letf (((symbol-function 'read-file-name) (lambda (&rest _) "task"))
              ((symbol-function 'my/agent-session--task-read)
               (lambda (_) '(:repo "owner/repo" :machine "a" :title "Task" :prompt "snapshot")))
              ((symbol-function 'completing-read)
               (lambda (prompt _choices &rest args)
                 (should (eq vertico-preselect 'prompt))
                 (should-not (nth 4 args))
                 (pcase prompt ("Start: " "Task-backed") ("Location: " "New repository worktree")
                        ("Machine: " "b") (_ (ert-fail "Repository hint should skip selection")))))
              ((symbol-function 'read-string)
               (lambda (prompt _initial _history default &rest _)
                 (should (string-prefix-p "Base ref" prompt))
                 (should (string-match-p (regexp-quote "origin/master") prompt))
                 (should (equal default "origin/master")) "origin/train")))
      (let ((context (my/agent-session--collect)))
        (should (equal (plist-get context :source) "/rpc:host:/srv/repo/master.git"))
        (should (equal (plist-get context :base) "origin/train"))))
    (cl-letf (((symbol-function 'my/agent-session--choice) (lambda (&rest _) (signal 'quit nil)))
              ((symbol-function 'my/agent-session--git) (lambda (&rest _) (ert-fail "No mutation on cancellation"))))
      (should (eq (condition-case nil (my/agent-session-start) (quit 'cancelled)) 'cancelled)))))

(ert-deftest my/agent-session-directory-starts-at-machine-browse-root ()
  (let ((my/agent-machines '(("only" :directory "/rpc:host:/general/"))) (choices '("Ad hoc" "Existing directory")))
    (cl-letf (((symbol-function 'my/agent-session--choice) (lambda (&rest _) (pop choices)))
              ((symbol-function 'read-directory-name)
               (lambda (_prompt directory &rest _)
                 (should (equal directory "/rpc:host:/general/"))
                 "/rpc:host:/unrelated/subdirectory/")))
      (let ((context (my/agent-session--collect)))
        (should-not choices)
        (should (equal (plist-get context :directory) "/rpc:host:/unrelated/subdirectory/"))
        (should-not (plist-get context :prompt))))))

(ert-deftest my/agent-session-real-vertico-no-machine-preselection ()
  (let ((vertico-preselect 'first))
    (dolist (navigate '(nil t))
      (let ((completing-read-function
             (lambda (_prompt choices predicate require-match initial history default &rest _)
               (should-not (or initial history default))
               (with-temp-buffer
                 (let ((minibuffer-completion-table choices)
                       (minibuffer-completion-predicate predicate)
                       (minibuffer--require-match require-match)
                       (minibuffer-default default) returned)
                   (vertico--update)
                   (should (= vertico--index -1))
                   (when navigate (vertico-next))
                   (cl-letf (((symbol-function 'exit-minibuffer)
                              (lambda () (setq returned (minibuffer-contents-no-properties)))))
                     (vertico-exit))
                   returned)))))
        (if navigate
            (should (equal (my/agent-session--choice "Machine: " '("a" "b")) "a"))
          (should-error (my/agent-session--choice "Machine: " '("a" "b")) :type 'user-error))))
    (should (eq vertico-preselect 'first))))

(ert-deftest my/agent-session-cancel-every-selection-before-mutation ()
  (let ((my/agent-machines
         '(("a" :directory "/local/" :repositories ((:name "repo" :path "/repo/main" :base-ref "origin/main")))
           ("b" :directory "/rpc:host:/browse/" :repositories ((:name "repo" :path "/repo/master.git" :base-ref "origin/main"))))))
    (dolist (stop '("Start: " "Task file: " "Location: " "Repository: " "Machine: " "Base ref: " "Directory: "))
      (cl-letf (((symbol-function 'completing-read)
                 (lambda (prompt _choices &rest _)
                   (when (equal stop prompt) (signal 'quit nil))
                   (pcase prompt
                     ("Start: " "Task-backed")
                     ("Location: " (if (equal stop "Directory: ") "Existing directory" "New repository worktree"))
                     ("Repository: " "repo") ("Machine: " "a"))))
                ((symbol-function 'read-file-name)
                 (lambda (prompt &rest _)
                   (when (equal stop prompt) (signal 'quit nil)) "file"))
                ((symbol-function 'my/agent-session--task-read)
                 (lambda (_) '(:title "Task" :prompt "snapshot" :repo "unavailable")))
                ((symbol-function 'read-string) (lambda (&rest _) (signal 'quit nil)))
                ((symbol-function 'read-directory-name) (lambda (&rest _) (signal 'quit nil)))
                ((symbol-function 'my/agent-session--git-result)
                 (lambda (&rest _) (ert-fail "Git before choices finished")))
                ((symbol-function 'agent-shell-start)
                 (lambda (&rest _) (ert-fail "Agent before choices finished"))))
        (should (eq (condition-case nil (my/agent-session-start) (quit 'cancelled)) 'cancelled))))))

(ert-deftest my/agent-session-partial-git-failure-reports-path ()
  (my/agent-session-test--agent
