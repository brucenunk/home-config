(ert-deftest my/agent-session-git-bare-linked-and-fetch ()
  (my/agent-session-test--repository
    (let* ((bare (expand-file-name "repo space/master.git" root))
           (linked (expand-file-name "repo space/linked" root))
           (commit (my/agent-session--base-resolve source "main")))
      (my/agent-session--git root "clone" "--bare" source bare)
      (my/agent-session--git source "remote" "add" "origin" bare)
      (should (equal commit (my/agent-session--base-resolve source "origin/main")))
      (should (equal commit (my/agent-session--base-resolve source "refs/remotes/origin/main")))
      (my/agent-session--git source "branch" "train/part-two")
      (should (equal commit (my/agent-session--base-resolve source "train/part-two")))
      (dolist (invalid '("--help" "main~1" "refs/tags/missing" "origin/--bad" "missing"))
        (should-error (my/agent-session--base-resolve source invalid)))
      (my/agent-session--git source "worktree" "add" "-b" "linked" linked "main")
      (dolist (git-source (list source bare linked))
        (let ((context (my/agent-session-test--context :source git-source)))
          (my/agent-session--name context)
          (should (equal (file-name-directory (directory-file-name (plist-get context :directory)))
                         (file-name-directory (directory-file-name source))))
          (my/agent-session--git git-source "worktree" "add" "--no-track" "-b"
                                 (plist-get context :branch) "--" (plist-get context :directory) commit)
          (should (equal commit (my/agent-session--git (plist-get context :directory) "rev-parse" "HEAD")))))
      (should (equal (my/agent-session--git source "branch" "--show-current") "main")))))

(ert-deftest my/agent-session-remote-paths-and-git-boundary ()
  (let ((source "/rpc:user@host#22:/srv/repo/master.git/") calls)
    (cl-letf (((symbol-function 'my/agent-session--git-result)
               (lambda (dir &rest args) (push (cons dir args) calls) '(1 . "")))
              ((symbol-function 'file-exists-p) (lambda (_) nil))
              ((symbol-function 'file-symlink-p) (lambda (_) nil)))
      (let ((context (my/agent-session-test--context :source source)))
        (my/agent-session--name context)
        (should (string-prefix-p "/rpc:user@host#22:/srv/repo/adhoc-" (plist-get context :directory)))
        (should (equal (caar calls) source))
        (should (string-prefix-p "/srv/repo/adhoc-" (file-local-name (plist-get context :directory))))))
    (cl-letf (((symbol-function 'process-file)
               (lambda (program infile destination display &rest args)
                 (should (equal program "git")) (should-not infile) (should-not display)
                 (should (equal default-directory source))
                 (should (equal args '("rev-parse" "HEAD")))
                 (with-current-buffer (car destination) (insert "commit\n")) 0)))
      (should (equal (my/agent-session--git source "rev-parse" "HEAD") "commit")))))

(ert-deftest my/agent-session-task-candidates-filter-and-identify-without-body-reads ()
  (let ((root (make-temp-file "agent-candidates-" t)))
    (unwind-protect
        (let* ((notes '("20261017T152149==todo--a-readable-title.md"
                        "epic/20261017T152150==todo--duplicate-title.md"
                        "other/20261017T152150==todo--duplicate-title.md"
                        "epic/20261017T152151==todo--duplicate-title.md"
                        "epic/20261017T152151==todo--duplicate-title__copy.md"
                        "20261017T152152==todo--duplicate-title--[1].md"))
               (excluded '("20261017T152149==done--not-actionable.md"
                           "epic/20261017T152149==discarded--not-actionable.md"
                           "20261017T152149--no-signature.md"
                           "unrelated==todo--file.md"
                           "20261017T152149==todo--backup.md~"
                           "#20261017T152149==todo--autosave.md#"
                           ".#20261017T152149==todo--lock.md"
                           "epic/20261017T152149==todo--other-extension.txt")))
          (dolist (name (append notes excluded))
            (let ((file (expand-file-name name root)))
              (make-directory (file-name-directory file) t)
              (with-temp-file file (insert "Never read this body"))))
          (make-directory (expand-file-name "20261017T152149==todo--directory.md" root))
          (cl-letf (((symbol-function 'insert-file-contents)
                     (lambda (&rest _) (ert-fail "Candidate presentation read a body")))
                    ((symbol-function 'my/agent-session--task-read)
                     (lambda (&rest _) (ert-fail "Candidate presentation parsed a task"))))
            (let* ((candidates (my/agent-session--task-candidates root))
                   (labels (mapcar #'car candidates)))
              (should (= (length labels) (length notes)))
              (let ((ids (mapcar (lambda (entry)
                                   (denote-retrieve-filename-identifier (cdr entry)))
                                 candidates)))
                (should (equal ids (sort (copy-sequence ids) #'string<))))
              (should (get-text-property 0 'face (car labels)))
              (should (equal (sort (delq nil (mapcar (lambda (entry)
                                                     (when (cdr entry) (file-relative-name (cdr entry) root)))
                                                   candidates)) #'string<)
                             (sort (copy-sequence notes) #'string<)))
              (should (> (length labels) (length (delete-dups (copy-sequence labels)))))
              (should (member "a readable title" labels))
              (should (member "duplicate title  [1]" labels))
              (should-not (cl-find-if (lambda (label) (string-match-p " · " label)) labels)))))
      (delete-directory root t))))

(ert-deftest my/agent-session-task-discovery-is-scoped-and-honours-denote-exclusions ()
  (let ((root (make-temp-file "agent-discovery-" t))
        (unrelated (make-temp-file "agent-unrelated-" t)))
    (unwind-protect
        (progn
          (dolist (name '("20261017T152149==todo--included.md"
                          "epic/20261017T152149==todo--nested.md"
                          ".hidden/20261017T152149==todo--hidden.md"
                          "excluded/20261017T152149==todo--excluded.md"
                          "20261017T152149==todo--ignored.md"))
            (let ((file (expand-file-name name root)))
              (make-directory (file-name-directory file) t)
              (write-region "" nil file nil 'silent)))
          (let ((denote-directory unrelated)
                (denote-excluded-directories-regexp "\\`excluded\\(?:/\\|\\'\\)")
                (denote-excluded-files-regexp "ignored"))
            (should (equal (sort (mapcar #'car (my/agent-session--task-candidates root)) #'string<)
                           '("included" "nested")))
            (should (equal denote-directory unrelated))))
      (delete-directory root t)
      (delete-directory unrelated t))))

(ert-deftest my/agent-session-task-hints-parse-only-bounded-saved-front-matter ()
  (let ((file (make-temp-file "agent-hints-" nil ".md")))
    (unwind-protect
        (progn
          (dolist (case '(("---\nrepo: 'owner/repo'\nmachine: \"wampa\"\n---\nrepo: wrong\n: [invalid YAML body"
                           . ("owner/repo" . "wampa"))
                          ("---\r\nrepo: owner/repo\r\nmachine: wampa\r\n---\r\nbody"
                           . ("owner/repo" . "wampa"))
                          ("---\nrepo: ' padded/repo '\n---\n" . ("padded/repo" . "—"))
                          ("---\nrepo: [not, a, string]\nmachine: ''\n---\n" . ("—" . "—"))
                          ("---\nrepo: \"bad\\nvalue\"\nmachine: wampa\n---\n" . ("—" . "wampa"))
                          ("---\nrepo: [broken\n---\n" . ("—" . "—"))
                          ("---\nrepo: owner/repo\n" . ("—" . "—"))
                          ("body\n---\nrepo: wrong\n---\n" . ("—" . "—"))))
            (write-region (car case) nil file nil 'silent)
            (let ((hints (my/agent-session--task-hints file)))
              (should-not (plist-get hints :title))
              (should (equal (cons (plist-get hints :repo) (plist-get hints :machine))
                             (cdr case)))))
          (write-region "---\ntitle: 'Fix HTTP/2: Preserve API Casing!'\n---\n" nil file nil 'silent)
          (should (equal (plist-get (my/agent-session--task-hints file) :title)
                         "Fix HTTP/2: Preserve API Casing!"))
          (dolist (title '("''" "[not, a, string]" "\"bad\\nvalue\""))
            (write-region (format "---\ntitle: %s\n---\n" title) nil file nil 'silent)
            (should-not (plist-get (my/agent-session--task-hints file) :title)))
          (write-region (concat "---\n# " (make-string (* 17 1024) ?x)
                                "\nrepo: beyond/limit\n---\n") nil file nil 'silent)
          (let ((read-file (symbol-function 'insert-file-contents)))
            (cl-letf (((symbol-function 'insert-file-contents)
                       (lambda (name &optional visit beg end &rest args)
                         (should (= end (* 16 1024)))
                         (apply read-file name visit beg end args))))
              (should (equal (my/agent-session--task-hints file)
                             '(:title nil :repo "—" :machine "—")))))
          (cl-letf (((symbol-function 'insert-file-contents)
                     (lambda (&rest _) (signal 'file-error '("Unreadable")))))
            (should (equal (my/agent-session--task-hints file)
                           '(:title nil :repo "—" :machine "—")))))
      (delete-file file))))

(ert-deftest my/agent-session-task-marginalia-aligns-columns-and-preserves-verbatim-titles ()
  (let* ((root (make-temp-file "agent-picker-" t))
         (notes '(("20261017T152149==todo--short.md" "a/b" "wampa" "Fix API Casing: HTTP/2")
                  ("20261017T152150==todo--a-much-longer-readable-title.md" "owner/long-repository" "work" "A Much Longer Readable Title")
                  ("epic/20261017T152151==todo--duplicate.md" "a/b" "work" "Duplicate: API")
                  ("other/20261017T152151==todo--different-filename.md" "a/b" "work" "Duplicate: API")
                  ("epic/20261017T152151==todo--duplicate__copy.md" "a/b" "work" "Duplicate: API")
                  ("20261017T152154==todo--literal-title.md" "a/b" "work" "Duplicate: API  [1]")
                  ("20261017T152153==todo--unicode-repo.md" "owner/工具" "wampa")
                  ("20261017T152152==done--do-not-read.md" "ignored" "ignored")))
         (original-annotators marginalia-annotators)
         (original-mode marginalia-mode)
         (read-hints (symbol-function 'my/agent-session--task-hints))
         reads)
    (unwind-protect
        (progn
          (marginalia-mode 1)
          (dolist (note notes)
            (let ((file (expand-file-name (car note) root)))
              (make-directory (file-name-directory file) t)
              (write-region (format "---\n%srepo: %s\nmachine: %s\n---\n"
                                    (if (nth 3 note) (format "title: %S\n" (nth 3 note)) "")
                                    (nth 1 note) (nth 2 note)) nil file nil 'silent)))
          (let* ((candidates (my/agent-session--task-candidates root))
                 (expected-candidates
                  (mapcar (lambda (entry)
                            (cons (or (nth 3 (assoc (file-relative-name (cdr entry) root) notes))
                                      (car entry))
                                  (cdr entry)))
                          candidates))
                 (selection-index 0))
            (cl-letf (((symbol-function 'my/agent-session--task-candidates)
                       (lambda (_) candidates))
                      ;; Batch ERT's current buffer is not displayed.  Supply
                      ;; the window that a real minibuffer would occupy.
                      ((symbol-function 'get-buffer-window-list)
                       (lambda (&rest _) (list (selected-window))))
                      ((symbol-function 'my/agent-session--task-hints)
                       (lambda (file)
                         (should-not (string-match-p "==done--" file))
                         (push file reads)
                         (funcall read-hints file))))
              (dolist (entry candidates)
                (setq reads nil)
                (let ((completing-read-function
                       (lambda (_prompt table predicate &rest _)
                         (let* ((metadata (completion-metadata "" table predicate))
                                (labels (all-completions "" table))
                                (marginalia-align 'left)
                                (marginalia--cand-width-max 0)
                                (affixate (completion-metadata-get metadata 'affixation-function))
                                (rows (funcall affixate labels)))
                           (should (member "Fix API Casing: HTTP/2" labels))
                           (should (member "A Much Longer Readable Title" labels))
                           (should (member "unicode repo" labels))
                           (should (member "Duplicate: API  [1]" labels))
                           (should-not (member "Duplicate: API  [2]" labels))
                           (should (= 3 (cl-count "Duplicate: API" labels :test #'equal)))
                           (should (eq (completion-metadata-get metadata 'category) 'my-agent-session))
                           ;; The real Marginalia integration must find this annotator.
                           (should (functionp (marginalia--annotator 'my-agent-session)))
                           (should (= (length reads) (length candidates)))
                           (let (column machine-column)
                             (dolist (row rows)
                               (let* ((annotation (nth 2 row))
                                      (align (get-text-property 0 'display annotation))
                                      (machine (string-match "\\(?:wampa\\|work\\) *\\'" annotation)))
                                 (should align)
                                 (should machine)
                                 (should (eq (get-text-property machine 'face annotation) 'shadow))
                                 (if column (should (equal align column)) (setq column align))
                                 (if machine-column
                                     (should (= (string-width annotation 0 machine) machine-column))
                                   (setq machine-column (string-width annotation 0 machine))))))
                           (cl-letf (((symbol-function 'insert-file-contents)
                                      (lambda (&rest _) (ert-fail "Redisplay read a file"))))
                             (dolist (candidate labels)
                               (funcall affixate (list (substring-no-properties candidate)))))
                           (substring-no-properties (nth selection-index labels))))))
                  (should (equal (my/agent-session--task-select)
                                 (cdr (assoc (car (nth selection-index expected-candidates))
                                             expected-candidates)))))
                (cl-incf selection-index))))
          (should (equal marginalia-annotators original-annotators)))
      (marginalia-mode (if original-mode 1 -1))
      (delete-directory root t))))

(ert-deftest my/agent-session-task-completion-narrows-to-distinct-files ()
  (let ((candidates '(("alpha task [one]" . "/one.md")
                      ("alpha task [two]" . "/two.md") ("zebra task" . "/zebra.md"))))
    (cl-letf (((symbol-function 'my/agent-session--task-candidates) (lambda (_) candidates)))
      (dolist (entry candidates)
        (let ((completing-read-function
               (lambda (prompt table predicate require-match &rest _)
                 (should (equal prompt "Task: "))
                 (should require-match)
                 (let ((metadata (completion-metadata "" table predicate)))
                   (should (eq (completion-metadata-get metadata 'category) 'my-agent-session))
                   (should (eq (completion-metadata-get metadata 'cycle-sort-function) #'identity))
                   (let ((vertico--metadata metadata)
                         (vertico-sort-function #'reverse))
                     (should (eq (vertico--sort-function) #'identity))))
                 (should (equal (all-completions "" table) (mapcar #'car candidates)))
                 (should (equal (all-completions "alpha" table) '("alpha task [one]" "alpha task [two]")))
                 (car entry))))
          (should (equal (my/agent-session--task-select) (cdr entry))))))))

(ert-deftest my/agent-session-empty-task-completion-stops-before-prompting ()
  (cl-letf (((symbol-function 'my/agent-session--task-candidates) (lambda (_) nil))
            ((symbol-function 'completing-read) (lambda (&rest _) (ert-fail "No task candidates")))
