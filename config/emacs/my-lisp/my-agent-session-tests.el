(ert-deftest my/agent-session-task-unsaved-buffer-does-not-mix-snapshots ()
  (let ((file (make-temp-file "task-snapshot-" nil ".md")) buffer)
    (unwind-protect
        (progn
          (with-temp-file file (insert "---\ntitle: Saved\n---\nbody"))
          (setq buffer (find-file-noselect file))
          (with-current-buffer buffer (goto-char (point-max)) (insert "unsaved"))
          (should-error (my/agent-session--task-read file) :type 'user-error))
      (when buffer (with-current-buffer buffer (set-buffer-modified-p nil)) (kill-buffer buffer))
      (delete-file file))))

(ert-deftest my/agent-session-narrowed-task-retains-front-matter-title ()
  (let ((file (make-temp-file "task-narrowed-" nil ".md")) buffer)
    (unwind-protect
        (progn
          (with-temp-file file (insert "---\ntitle: Full task title\n---\ntitle: Not metadata\nBody"))
          (setq buffer (find-file-noselect file))
          (with-current-buffer buffer
            (goto-char (point-min))
            (forward-line 3)
            (narrow-to-region (point) (point-max)))
          (let ((task (my/agent-session--task-read file)))
            (should (equal (plist-get task :title) "Full task title"))
            (should (string-match-p "title: Not metadata" (plist-get task :prompt))))
          (with-current-buffer buffer (should (buffer-narrowed-p))))
      (when buffer (kill-buffer buffer))
      (delete-file file))))

(ert-deftest my/agent-session-task-byte-limit-before-decoding ()
  (let ((file (make-temp-file "task-bytes-" nil ".md")))
    (unwind-protect
        (progn
          (with-temp-file file
            (insert "---\ntitle: Multibyte\n---\n" (make-string 100000 ?雪)))
          ;; Fewer than 256 Ki characters but more than 256 Ki bytes: never
          ;; launch with just the first bounded read decoded as a partial task.
          (should-error (my/agent-session--task-read file) :type 'user-error)
          (with-temp-file file (insert "---\ntitle: Multibyte\n---\n雪☃"))
          (should (string-suffix-p "雪☃" (plist-get (my/agent-session--task-read file) :prompt))))
      (delete-file file))))

(ert-deftest my/agent-session-independent-overrides ()
  (dolist (fields '(nil (:model "provider/vendor/other") (:thinking "high")
                       (:model "provider/vendor/other" :thinking "off")))
    (my/agent-session-test--agent
      (setq my/agent-session-test--initialized t)
      (let ((context (apply #'my/agent-session-test--context :prompt "snapshot" fields)))
        (my/agent-session--launch context)
        (should (= 1 (cl-count 'insert my/agent-session-test--calls :key #'car)))
        (should (= (/ (length fields) 2)
                   (cl-count 'set my/agent-session-test--calls :key #'car)))
        (let ((ordered (reverse my/agent-session-test--calls)))
          (should (eq (caar (last ordered)) 'insert))
          (when (= (length fields) 4)
            (should (equal (nth 2 (nth 1 ordered)) "model"))
            (should (equal (nth 2 (nth 2 ordered)) "thought_level")))))))
  (my/agent-session-test--agent
    (setq my/agent-session-test--initialized t)
    (let ((context (my/agent-session-test--context)))
      (my/agent-session--launch context)
      (should (string-prefix-p "Agent session ready:" (car my/agent-session-test--messages)))
      (should-not (assq 'set my/agent-session-test--calls))
      (should-not (assq 'insert my/agent-session-test--calls)))))

(ert-deftest my/agent-session-complete-task-to-public-api-after-overrides ()
  ;; The boundary is the public API, not literal ACP wire output.  Agent-shell
  ;; keeps its normal @file processing, exactly as for pasted user input.
  (let* ((file (make-temp-file "task-public-api-" nil ".md"))
         (text "---\ntitle: Full task\nmodel: provider/vendor/other\nthinking: high\nskill: task-workflow-v3\n---\nRead @README.md and @\"file with spaces.md\".\n---\nKeep this whole body.\n")
         (my/agent-machines '(("remote" :directory "/rpc:host:/browse/")))
         (choices '("Task-backed" "Existing directory")))
    (unwind-protect
        (progn
          (with-temp-file file (insert text))
          (my/agent-session-test--agent
            (setq my/agent-session-test--setter 'pending)
            (cl-letf (((symbol-function 'my/agent-session--choice) (lambda (&rest _) (pop choices)))
                      ((symbol-function 'read-file-name) (lambda (&rest _) file))
                      ((symbol-function 'read-directory-name) (lambda (&rest _) "/rpc:host:/project/subdir/")))
              (let* ((context (my/agent-session--collect))
                     (shell (my/agent-session--launch context)))
                (should-not (assq 'set my/agent-session-test--calls))
                (should-not (assq 'insert my/agent-session-test--calls))
                (my/agent-session-test--event shell 'init-finished)
                (my/agent-session-test--event shell 'init-finished)
                (dolist (expected '("model" "thought_level"))
                  (should-not (assq 'insert my/agent-session-test--calls))
                  (let ((args (pop my/agent-session-test--pending)))
                    (should (equal (plist-get args :category) expected))
                    (should (eq (plist-get args :shell-buffer) shell))
                    (setf (alist-get expected my/agent-session-test--current nil nil #'equal)
                          (plist-get args :value))
                    (funcall (plist-get args :on-success) nil)
                    ;; A duplicate completion cannot advance configuration or
                    ;; submit the task again.
                    (funcall (plist-get args :on-success) nil)))
                (let ((args (cdr (assq 'insert my/agent-session-test--calls))))
                  (should (eq (plist-get args :shell-buffer) shell))
                  (should (plist-get args :submit))
                  (should (equal (plist-get args :text)
                                 (concat
                                  (format "Task snapshot read by Emacs from %s.\nThis provenance path is not necessarily accessible or editable on the agent host.\n\n" file)
                                  text "\n\nLoad the task-workflow-v3 agent skill and follow instructions."))))
                (should (equal (mapcar #'car (reverse my/agent-session-test--calls))
                               '(start set set insert)))
                (should-not my/agent-session-test--subscriptions)))))
      (delete-file file))))

(ert-deftest my/agent-session-adhoc-display-uses-directory-basename ()
  (my/agent-session-test--agent
    (dolist (directory '("/general/project/subdirectory/" "/rpc:host:/srv/example/"))
      (let ((shell (my/agent-session--launch
                    (my/agent-session-test--context :title nil :directory directory))))
        (should (equal (buffer-name shell)
                       (concat "Pi · " (file-name-nondirectory (directory-file-name (file-local-name directory)))))))))
  (my/agent-session-test--repository
    (my/agent-session-test--agent
      (let ((options (my/agent-session-test--context :title nil :source source)))
        (my/agent-session--name options)
        (let ((shell (my/agent-session--launch options)))
          (should (equal (buffer-name shell) (concat "Pi · " (plist-get options :branch)))))))))

