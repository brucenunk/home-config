;;; my-agent-session-tests.el --- Isolated launch tests -*- lexical-binding: t -*-

;;; Commentary:
;; Real temporary Git repositories; simulated agent and remote file handlers.
;; No live agents, SSH connections or shared Emacs processes are used.

;;; Code:

(require 'ert)
(require 'my-agent-session)
(require 'agent-shell-tramp)
(require 'tramp-rpc)
(require 'vertico)

(defun my/agent-session-test--context (&rest values)
  "Make launch options with VALUES; no runtime or recovery state is retained."
  (let ((context (list :branch nil :machine "test" :source nil :base "main" :directory temporary-file-directory
                       :title "Full task title" :worktree nil :prompt nil
                       :model nil :thinking nil)))
    (while values (setf (plist-get context (pop values)) (pop values)))
    context))

(defmacro my/agent-session-test--repository (&rest body)
  "Run BODY with temporary `root' and `source' Git directories."
  (declare (indent 0))
  `(let* ((root (make-temp-file "agent-session-" t))
          (source (expand-file-name "repo space/main" root)))
     (unwind-protect
         (progn
           (make-directory source t)
           (my/agent-session--git source "init" "--initial-branch=main")
           (my/agent-session--git source "-c" "user.name=Test" "-c" "user.email=test@example.invalid"
                                  "commit" "--allow-empty" "-m" "Initial")
           ,@body)
       (delete-directory root t))))

(defvar my/agent-session-test--subscriptions)
(defvar my/agent-session-test--calls)
(defvar my/agent-session-test--buffers)
(defvar my/agent-session-test--initialized)
(defvar my/agent-session-test--setter)
(defvar my/agent-session-test--current)
(defvar my/agent-session-test--pending)
(defvar my/agent-session-test--messages)

(defun my/agent-session-test--event (shell event)
  "Emit EVENT for SHELL using the simulated agent subscriptions."
  (dolist (entry (reverse my/agent-session-test--subscriptions))
    (when (and (eq (nth 0 entry) shell) (eq (nth 1 entry) event))
      (funcall (nth 2 entry) (list (cons :event event))))))

(defmacro my/agent-session-test--agent (&rest body)
  "Run BODY with a simulated asynchronous agent behind the pinned public APIs."
  (declare (indent 0))
  `(let ((my/agent-session-test--subscriptions nil)
         (my/agent-session-test--calls nil)
         (my/agent-session-test--buffers nil)
         (my/agent-session-test--initialized nil)
         (my/agent-session-test--setter 'success)
         (my/agent-session-test--current (copy-tree '(("model" . "provider/default") ("thought_level" . "medium"))))
         (my/agent-session-test--pending nil)
         (my/agent-session-test--messages nil)
         (agent-shell-prefer-viewport-interaction nil))
     (unwind-protect
         (cl-letf (((symbol-function 'agent-shell-start)
                    (lambda (&rest args)
                      (push (list 'start default-directory (funcall agent-shell-cwd-function)
                                  agent-shell-session-strategy args)
                            my/agent-session-test--calls)
                      (let ((buffer (generate-new-buffer (funcall agent-shell-buffer-name-format "Pi" "project"))))
                        (push buffer my/agent-session-test--buffers)
                        (funcall (map-elt (plist-get args :config) :client-maker) buffer)
                        buffer)))
                   ((symbol-function 'agent-shell-pi-make-agent-config)
                    (lambda () (list (cons :client-maker (lambda (_buffer) nil)))))
                   ((symbol-function 'agent-shell-subscribe-to)
                    (lambda (&rest args)
                      (let ((token (list (plist-get args :shell-buffer) (plist-get args :event)
                                         (plist-get args :on-event))))
                        (push token my/agent-session-test--subscriptions)
                        token)))
                   ((symbol-function 'agent-shell-unsubscribe)
                    (lambda (&rest args)
                      (setq my/agent-session-test--subscriptions
                            (delq (plist-get args :subscription) my/agent-session-test--subscriptions))))
                   ((symbol-function 'agent-shell-initialized-p)
                    (lambda (&rest _) my/agent-session-test--initialized))
                   ((symbol-function 'agent-shell-config-option)
                    (lambda (&rest args)
                      (let ((category (plist-get args :category)))
                        (list (cons :options
                                    (mapcar (lambda (value) (list (cons :value value)))
                                            (if (equal category "model")
                                                '("provider/default" "provider/vendor/other")
                                              '("off" "medium" "high"))))))))
                   ((symbol-function 'agent-shell-config-option-value)
                    (lambda (&rest args)
                      (cdr (assoc (plist-get args :category) my/agent-session-test--current))))
                   ((symbol-function 'agent-shell-set-config-option-value)
                    (lambda (&rest args)
                      (push (list 'set (plist-get args :shell-buffer) (plist-get args :category)
                                  (plist-get args :value)) my/agent-session-test--calls)
                      (pcase my/agent-session-test--setter
                        ('failure (funcall (plist-get args :on-failure) '((:acp-error . "Rejected"))))
                        ('pending (push args my/agent-session-test--pending))
                        (_ (unless (eq my/agent-session-test--setter 'unapplied)
                             (setf (alist-get (plist-get args :category) my/agent-session-test--current nil nil #'equal)
                                   (plist-get args :value)))
                           (funcall (plist-get args :on-success) nil)))))
                   ((symbol-function 'agent-shell-insert)
                    (lambda (&rest args)
                      (push (cons 'insert args) my/agent-session-test--calls)
                      (when (eq my/agent-session-test--setter 'send-error)
                        (error "Submission outcome unknown"))))
                   ((symbol-function 'message)
                    (lambda (format-string &rest args)
                      (let ((text (apply #'format format-string args)))
                        (push text my/agent-session-test--messages) text))))
           ,@body)
       (dolist (buffer my/agent-session-test--buffers)
         (when (buffer-live-p buffer) (kill-buffer buffer))))))

(ert-deftest my/agent-session-task-snapshot ()
  (let ((file (make-temp-file "task-" nil ".md")))
    (unwind-protect
        (progn
          (with-temp-file file
            (insert "---\ntitle: \"Full title: with punctuation\"\nrepo: owner/repo\nmodel: provider/vendor/model\nthinking: high\nskill: task-workflow-v3\n---\nBody\n---\nMore body\n"))
          (let ((task (my/agent-session--task-read file)))
            (should (equal (plist-get task :title) "Full title: with punctuation"))
            (should (equal (plist-get task :model) "provider/vendor/model"))
            (should (string-match-p "Body\n---\nMore body" (plist-get task :prompt)))
            (should (string-match-p "not necessarily accessible or editable" (plist-get task :prompt)))
            (should (string-match-p "Load the task-workflow-v3 agent skill" (plist-get task :prompt)))))
      (delete-file file))))

(ert-deftest my/agent-session-task-invalid-and-no-skill ()
  (let ((file (make-temp-file "task-" nil ".md")))
    (unwind-protect
        (progn
          (dolist (text '("Plain prompt" "---\ntitle: Unclosed\n" "---\nmodel: []\n---\nbody"
                          "---\nskill: bad name\n---\nbody"))
            (with-temp-file file (insert text))
            (should-error (my/agent-session--task-read file)))
          (with-temp-file file (insert "---\nthinking: off\n---\nBody"))
          (let ((task (my/agent-session--task-read file)))
            (should (equal (plist-get task :thinking) "off"))
            (should (equal (plist-get task :title) (file-name-base file)))
            (should-not (string-match-p "Load the" (plist-get task :prompt)))))
      (delete-file file))))

