(ert-deftest my/agent-session-transcripts-flat-local-paths-and-native-remote-writes ()
  ;; Native path policy and transcript writer, with only the remote directory
  ;; existence boundary simulated.  No TRAMP operation may open a connection.
  (let* ((root (make-temp-file "agent-transcripts-" t))
         (my/agent-shell-transcript-directory (expand-file-name "transcripts/" root))
         (local (expand-file-name "project/" root))
         (directory-p (symbol-function 'file-directory-p))
         (mkdir (symbol-function 'make-directory))
         (timestamp (symbol-function 'format-time-string))
         (cwds (list local local "/rpc:user@one#22:/srv/project/" "/rpc:user@two#22:/srv/project/"
                     "/rpc:user@one#222:/srv/project/" "/rpc:other@one#22:/srv/project/"))
         paths directories)
    (unwind-protect
        (progn
          (make-directory local)
          (cl-letf (((symbol-function 'format-time-string)
                     (lambda (format &optional _time zone) (funcall timestamp format '(0 0 0 0) zone)))
                    ((symbol-function 'make-directory)
                     (lambda (dir &optional parents)
                       (should-not (file-remote-p dir))
                       (funcall mkdir dir parents)
                       (should (equal (file-name-as-directory dir) my/agent-shell-transcript-directory))
                       (push dir directories)))
                    ((symbol-function 'file-directory-p)
                     (lambda (dir) (if (file-remote-p dir) t (funcall directory-p dir))))
                    ((symbol-function 'tramp-maybe-open-connection)
                     (lambda (&rest _) (ert-fail "Transcript policy attempted a remote connection"))))
            ;; Generate all paths before any file exists, including concurrent
            ;; same-second sessions.  Generation must not reserve directories.
            (setq paths (mapcar (lambda (cwd)
                                  (let ((default-directory cwd))
                                    (funcall agent-shell-transcript-file-path-function)))
                                cwds))
            (should-not (file-exists-p my/agent-shell-transcript-directory))
            (should-not directories)
            (should (= (length paths) (length (delete-dups (copy-sequence paths)))))
            (cl-loop for cwd in cwds for path in paths do
              (with-temp-buffer
                (let* ((default-directory cwd)
                       (major-mode 'agent-shell-mode)
                       (agent-shell-cwd-function (lambda () cwd))
                       (agent-shell--state (list (cons :session (list (cons :id "fixture-session")))))
                       (agent-shell--transcript-file path))
                  (should-not (file-exists-p agent-shell--transcript-file))
                  (should-not (file-remote-p agent-shell--transcript-file))
                  (should (equal (file-name-directory path) my/agent-shell-transcript-directory))
                  (should (equal (file-name-extension path) "md"))
                  (agent-shell--append-transcript :text "Task snapshot\n" :file-path agent-shell--transcript-file)
                  (should (file-exists-p agent-shell--transcript-file))
                  (with-temp-buffer
                    (insert-file-contents path)
                    (should (string-match-p "# Agent Shell Transcript" (buffer-string)))
                    (should (string-match-p "fixture-session" (buffer-string)))
                    (should (string-match-p (regexp-quote cwd) (buffer-string)))
                    (should (string-suffix-p "Task snapshot\n" (buffer-string))))))))
          (should directories)
          (should (= (length paths) (length (directory-files my/agent-shell-transcript-directory nil "\\.md\\'"))))
          (should-not (directory-files local nil directory-files-no-dot-files-regexp)))
      (delete-directory root t))))

(ert-deftest my/agent-session-transcript-filename-skips-existing-files-and-symlinks ()
  (let* ((root (make-temp-file "agent-transcript-collisions-" t))
         (my/agent-shell-transcript-directory (file-name-as-directory root))
         (existing (expand-file-name "existing.md" root))
         (dangling (expand-file-name "dangling.md" root))
         (unused (expand-file-name "unused.md" root))
         (names (mapcar #'file-name-sans-extension (list existing dangling unused))))
    (unwind-protect
        (progn
          (with-temp-file existing (insert "Preserve existing transcript"))
          (make-symbolic-link "missing" dangling)
          (cl-letf (((symbol-function 'make-temp-name) (lambda (_) (or (pop names) (ert-fail "Unexpected retry")))))
            (should (equal (my/agent-shell--transcript-file-path) unused))
            (should-not names)
            (should-not (file-exists-p unused)))
          (with-temp-buffer
            (insert-file-contents existing)
            (should (equal (buffer-string) "Preserve existing transcript"))))
      (delete-directory root t))))

(ert-deftest my/agent-session-native-start-and-submit-leaves-worktree-clean ()
  ;; Full worktree creation and pinned ordinary startup/insertion/submission.
  ;; Only ACP initialization/transport is replaced; transcript code is real.
  (my/agent-session-test--repository
    (let* ((my/agent-shell-transcript-directory (expand-file-name "transcripts/" root))
           (agent-shell-prefer-viewport-interaction nil)
           (agent-shell-show-welcome-message nil)
           (agent-shell-pi-acp-command (list (executable-find "git")))
           (task-file (expand-file-name "task.md" root))
           (my/agent-machines (list (list "only" :directory root :repositories
                                         (list (list :name "repo" :path source :base-ref "main")))))
           (exclude (expand-file-name ".git/info/exclude" source))
           (exclude-before (with-temp-buffer (insert-file-contents exclude) (buffer-string)))
           shell requests)
      (with-temp-file task-file (insert "---\ntitle: Task\nrepo: repo\n---\nTask snapshot"))
      (unwind-protect
          (cl-letf (((symbol-function 'read-string) (lambda (&rest _) "main"))
                    ((symbol-function 'agent-shell--handle)
                     (lambda (&rest args)
                       (with-current-buffer (plist-get args :shell-buffer)
                         (setf (map-elt agent-shell--state :session) (list (cons :id "fixture-session") (cons :title nil))
                               (map-elt agent-shell--state :init-finished) t)
                         (when-let* ((command (plist-get args :command)))
                           (agent-shell--send-command :prompt command :shell-buffer (current-buffer))))))
                    ((symbol-function 'agent-shell--send-request)
                     (lambda (&rest args) (push (plist-get args :request) requests)))
                    ((symbol-function 'agent-shell--display-buffer) #'ignore))
            (setq shell (my/agent-session-start-from-file task-file))
            (should (buffer-live-p shell))
            (should (= 1 (length requests)))
            (with-current-buffer shell
              (should (equal (file-name-directory agent-shell--transcript-file) my/agent-shell-transcript-directory))
              (should (file-exists-p agent-shell--transcript-file))
              (with-temp-buffer
                (insert-file-contents (buffer-local-value 'agent-shell--transcript-file shell))
                (should (string-match-p "Task snapshot" (buffer-string)))))
            (dolist (directory (list source (with-current-buffer shell (agent-shell-cwd))))
              (should (equal "" (my/agent-session--git directory "status" "--porcelain" "--untracked-files=all")))
              (should-not (file-exists-p (expand-file-name ".agent-shell" directory))))
            (with-temp-buffer
              (insert-file-contents exclude)
              (should (equal (buffer-string) exclude-before))))
        (when (buffer-live-p shell)
          (with-current-buffer shell (setq-local kill-buffer-query-functions nil) (kill-buffer shell)))))))

