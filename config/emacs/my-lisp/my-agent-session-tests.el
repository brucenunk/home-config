(ert-deftest my/agent-session-real-viewport-task-view-and-adhoc-compose ()
  ;; Exercise the real pinned startup, insertion, submission and viewport APIs.
  ;; Replace only ACP initialization/transport: no live agent is started.
  (dolist (synchronous '(nil t))
    (dolist (case '((nil) ("Task snapshot for viewport display")
                    ("Task snapshot for viewport display" "Preserve this user draft")
                    ("Task snapshot for viewport display" "  \n")))
      (let* ((prompt (car case))
             (draft (and (not synchronous) (cadr case)))
             (root (make-temp-file "agent-viewport-" t))
             (agent-shell-prefer-viewport-interaction t)
             (agent-shell-show-busy-indicator nil)
             (agent-shell-show-welcome-message nil)
             (agent-shell-transcript-file-path-function (lambda () nil))
             (agent-shell-pi-acp-command (list (executable-find "git")))
             (context (my/agent-session-test--context :directory root :prompt prompt))
             shell viewport requests)
        (unwind-protect
            (save-window-excursion
              (cl-letf (((symbol-function 'agent-shell--handle)
                         (lambda (&rest args)
                           (with-current-buffer (plist-get args :shell-buffer)
                             (when synchronous
                               (setf (map-elt agent-shell--state :session)
                                     (list (cons :id "fake-session") (cons :title nil))
                                     (map-elt agent-shell--state :init-finished) t))
                             (when-let* ((command (plist-get args :command)))
                               (agent-shell--send-command :prompt command :shell-buffer (current-buffer))))))
                        ((symbol-function 'agent-shell--send-request)
                         (lambda (&rest args) (push (plist-get args :request) requests))))
                (progn
                  (setq shell (my/agent-session--launch context)
                        viewport (agent-shell-viewport--buffer :shell-buffer shell :existing-only t))
                  (should (buffer-live-p shell))
                  (should (buffer-live-p viewport))
                  (unless synchronous
                    (with-current-buffer viewport
                      (should (derived-mode-p 'agent-shell-viewport-edit-mode))
                      (when draft (insert draft)))
                    (with-current-buffer shell
                      (setf (map-elt agent-shell--state :session)
                            (list (cons :id "fake-session") (cons :title nil))
                            (map-elt agent-shell--state :init-finished) t)
                      (agent-shell--emit-event :event 'init-finished)))
                  (with-current-buffer viewport
                    (if prompt
                        (progn
                          (ert-info ((format "requests=%s shell=%s" (length requests)
                                             (with-current-buffer shell
                                               (buffer-substring-no-properties (point-min) (point-max)))))
                            (should (= (length requests) 1))
                            (if draft
                                (progn
                                  (should (derived-mode-p 'agent-shell-viewport-edit-mode))
                                  (should (equal (buffer-string) draft)))
                              (should (derived-mode-p 'agent-shell-viewport-view-mode))
                              (should (string-match-p (regexp-quote prompt) (buffer-string))))))
                      (should (derived-mode-p 'agent-shell-viewport-edit-mode))
                      (should-not requests))))))
          (when (buffer-live-p viewport) (kill-buffer viewport))
          (when (buffer-live-p shell)
            (with-current-buffer shell
              (setq-local kill-buffer-query-functions nil)
              (kill-buffer shell)))
          (delete-directory root t))))))

(ert-deftest my/agent-session-real-start-from-shell-is-new-and-preserves-draft ()
  (dolist (strategy '(prompt latest))
    (let* ((root (make-temp-file "agent-start-" t))
           (agent-shell-session-strategy strategy)
           (agent-shell-prefer-viewport-interaction nil)
           (agent-shell-show-welcome-message nil)
           (agent-shell-transcript-file-path-function (lambda () nil))
           (agent-shell-pi-acp-command (list (executable-find "git")))
           (enable-dir-local-variables t)
           (safe-local-variable-values '((agent-shell-session-strategy . latest)))
           (context (my/agent-session-test--context :directory root :prompt "Task snapshot"))
           first second reported)
      (unwind-protect
          (save-window-excursion
            (with-temp-file (expand-file-name ".dir-locals.el" root)
              (insert "((nil . ((agent-shell-session-strategy . latest))))"))
            (with-temp-buffer
              (let ((default-directory (file-name-as-directory root)))
                (hack-dir-local-variables-non-file-buffer)
                ;; Prove this approved setting applies to an ordinary caller.
                (should (eq agent-shell-session-strategy 'latest))))
            (cl-letf (((symbol-function 'agent-shell--handle) #'ignore)
                      ((symbol-function 'my/agent-session--report-failure)
                       (lambda (&rest args) (setq reported args)))
                      ((symbol-function 'display-buffer) #'ignore)
                      ;; The pinned display helper selects the returned window.
                      ((symbol-function 'agent-shell--display-buffer) #'ignore))
              (setq first (my/agent-session--launch context))
              (should (buffer-live-p first))
              (with-current-buffer first
                (should (eq agent-shell-session-strategy 'new))
                (setq-local agent-shell-session-strategy strategy)
                (goto-char (point-max))
                (insert "Unsent shell draft")
                (setf (map-elt agent-shell--state :session)
                      (list (cons :id "fake-session") (cons :title nil))
                      (map-elt agent-shell--state :init-finished) t)
                (agent-shell--emit-event :event 'init-finished)
                (should (eq (nth 2 reported) first))
                (should (string-match-p "Unsent shell input" (nth 3 reported)))
                (should (string-suffix-p "Unsent shell draft" (buffer-string)))
                (should-not (string-match-p "Task snapshot" (buffer-string)))
                ;; A separate invocation is still fresh even from a shell with
                ;; local strategy settings. There is no retained relaunch state.
                (setq second (my/agent-session--launch
                              (my/agent-session-test--context :directory root :title nil)))
                (should (string-suffix-p "Unsent shell draft" (buffer-string))))
              (should (buffer-live-p second))
              (should-not (eq first second))
              (with-current-buffer second
                (should (eq agent-shell-session-strategy 'new))
                (should (equal (directory-file-name (agent-shell-cwd)) root)))
              (should (eq (default-value 'agent-shell-session-strategy) strategy))))
        (dolist (buffer (list first second))
          (when (buffer-live-p buffer)
            (with-current-buffer buffer
              (setq-local kill-buffer-query-functions nil)
              (kill-buffer buffer))))
        (delete-directory root t)))))

(ert-deftest my/agent-session-real-error-before-starter-returns ()
  (let* ((root (make-temp-file "agent-early-error-" t))
         (agent-shell-prefer-viewport-interaction nil)
         (agent-shell-show-welcome-message nil)
         (agent-shell-transcript-file-path-function (lambda () nil))
         (agent-shell-pi-acp-command (list (executable-find "git")))
         (context (my/agent-session-test--context :directory root :prompt "Task snapshot"))
         first reported)
    (unwind-protect
        (cl-letf (((symbol-function 'agent-shell--handle)
                   (lambda (&rest args)
                     (with-current-buffer (plist-get args :shell-buffer)
                       ;; Match real bootstrap: invoke the configured factory
                       ;; with full state, then service an immediate rejection.
                       (funcall (map-elt agent-shell--state :client-maker) (current-buffer))
                       (agent-shell--emit-event :event 'error))))
                  ((symbol-function 'my/agent-session--report-failure)
                   (lambda (&rest args) (setq reported args)))
                  ((symbol-function 'display-buffer) #'ignore)
                  ((symbol-function 'agent-shell--display-buffer) #'ignore))
          (setq first (my/agent-session--launch context))
          (should (buffer-live-p first))
          (should (equal (car reported) root))
          (should (eq (nth 2 reported) first))
          (should (string-match-p "Startup/configuration" (nth 3 reported)))
          (with-current-buffer first
            (agent-shell--emit-event :event 'init-finished)
            (should-not (string-match-p "Task snapshot" (buffer-string)))))
      (dolist (buffer (list first))
        (when (buffer-live-p buffer)
          (with-current-buffer buffer
            (setq-local kill-buffer-query-functions nil)
            (kill-buffer buffer))))
      (delete-directory root t))))

(ert-deftest my/agent-session-failures-and-closure-block-late-submission ()
