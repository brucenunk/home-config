(ert-deftest my/task-session-state-remove-does-not-recreate-missing-entry ()
  (my/task-index-test--with-isolated-index
    (let ((task-id "20260324T082727"))
      (puthash task-id (my/task-index-test--entry task-id :worktree "/tmp/a/") my/task-index)
      (cl-letf (((symbol-function 'my/task-resolve-id) (lambda (task) task))
                ((symbol-function 'my/task-state-notify) (lambda (&rest _) nil)))
        (provide 'consult)
        (require 'my-task-session)
        (remhash task-id my/task-index)
        (my/task-session-state-remove task-id)
        (should-not (gethash task-id my/task-index))))))

(ert-deftest my/task-session-state-add-marks-session-active ()
  (provide 'consult)
  (require 'my-task-session)
  (let (active-calls)
    (cl-letf (((symbol-function 'my/task-resolve-id) (lambda (task) task))
              ((symbol-function 'my/task-session-active-set)
               (lambda (task active)
                 (push (list task active) active-calls))))
      (my/task-session-state-add "without-skill")
      (my/task-session-state-add "with-skill")
      (should (equal (nreverse active-calls)
                     '(("without-skill" t)
                       ("with-skill" t)))))))

