                 (funcall (plist-get args :on-success)
                          '(:outcome started
                            :unusable-worktrees ((:path "/tmp/e/" :reason dirty))))))
              ((symbol-function 'message)
               (lambda (format-string &rest args)
                 (setq captured-message (apply #'format format-string args)))))
      (my/task-session-command-pickup "20260324T082727")
      (should (equal captured-message
                     "Skipped unusable worktrees: /tmp/e/")))))

