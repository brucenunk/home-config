(ert-deftest my/task-session-active-ids-skips-global-repair ()
  (provide 'consult)
  (require 'my-task-session)
  (let ((sync-called nil))
    (cl-letf (((symbol-function 'my/task--repair-index)
               (lambda ()
                 (ert-fail "global repair should not run on active-session lookup")))
              ((symbol-function 'my/task-session-sync-active)
               (lambda ()
                 (setq sync-called t)
                 '("20260324T082727")))
              ((symbol-function 'my/task-index-entries-where)
               (lambda (_prop _value)
                 (list (list :task-id "20260324T082727" :active t)
                       (list :task-id "20260324T082728" :active t)))))
      (should (equal (my/task-session-active-ids)
                     '("20260324T082727" "20260324T082728")))
      (should sync-called))))

(ert-deftest my/task-session-active-ids-clears-stale-active-entry-without-global-repair ()
  (my/task-index-test--with-isolated-index
    (provide 'consult)
    (require 'my-task-session)
    (let ((task-id "20260324T082727")
          notifications)
      (puthash task-id
               (my/task-index-test--entry task-id :worktree "/tmp/a/" :active t)
               my/task-index)
      (cl-letf (((symbol-function 'my/task--repair-index)
                 (lambda ()
                   (ert-fail "global repair should not run on active-session lookup")))
                ((symbol-function 'my/task-file)
                 (lambda (_task-id)
                   "/tmp/task.md"))
                ((symbol-function 'my/task-status)
                 (lambda (_task)
                   "todo"))
                ((symbol-function 'my/task-session-live-buffer)
                 (lambda (_task-id)
                   nil))
                ((symbol-function 'my/task-state-notify)
                 (lambda (&rest args)
                   (push args notifications))))
        (should-not (my/task-session-active-ids))
        (should-not (plist-get (gethash task-id my/task-index) :active))
        (should (= (length notifications) 1))
        (should-not (plist-get (nthcdr 2 (car notifications)) :active))))))

(ert-deftest my/task-session-sync-active-prunes-live-stale-session ()
  (my/task-index-test--with-isolated-index
    (provide 'consult)
    (require 'my-task-session)
    (let ((task-id "20260324T082727")
          pruned)
      (puthash task-id
               (my/task-index-test--entry task-id :worktree "/tmp/a/" :active t)
               my/task-index)
      (with-temp-buffer
        (rename-buffer (format "agent-task-%s" task-id) t)
        (setq-local my/task-session-task-id task-id)
        (cl-letf (((symbol-function 'my/agent-session-live-p)
                   (lambda (_buffer)
                     t))
                  ((symbol-function 'my/task-session-sync-entry)
                   (lambda (&rest _) nil))
                  ((symbol-function 'my/task-session-stale-reason)
                   (lambda (_task-id &optional _entry)
                     'missing-worktree))
                  ((symbol-function 'my/task-session-prune-stale)
                   (lambda (id reason)
                     (push (list id reason) pruned))))
          (should (equal (my/task-session-sync-active) (list task-id)))
          (should (equal pruned
                         (list (list task-id 'missing-worktree)))))))))

(ert-deftest my/task-session-sync-active-keeps-live-session-with-shared-task-root ()
  (my/task-index-test--with-isolated-index
    (provide 'consult)
    (require 'my-task-session)
    (let* ((temp-root (make-temp-file "my-task-session-shared-root" t))
           (tasks-root (expand-file-name "tasks/" temp-root))
           (epic-dir (expand-file-name "session-bugs/" tasks-root))
           (task-id "20260324T082727")
           (task-file (expand-file-name
                       (format "%s==todo--shared-root-live-session.md" task-id)
                       epic-dir))
           (my/task--file-cache (make-hash-table :test 'equal)))
      (make-directory epic-dir t)
      (unwind-protect
          (progn
            (with-temp-file task-file
              (insert "---\n---\n"))
            (puthash task-id
                     (my/task-index-test--entry task-id :worktree "/tmp/a/" :active t)
                     my/task-index)
            (with-temp-buffer
              (rename-buffer (format "agent-task-%s" task-id) t)
              (setq default-directory "/tmp/a/")
              (setq-local my/task-session-task-id task-id)
              (let ((denote-directory tasks-root))
                (cl-letf (((symbol-function 'my/agent-session-live-p)
                           (lambda (_buffer)
                             t))
                          ((symbol-function 'my/task--task-directories)
                           (lambda ()
                             (list tasks-root)))
                          ((symbol-function 'denote-get-path-by-id) (lambda (_id) nil))
                          ((symbol-function 'denote-retrieve-filename-signature)
                           (lambda (file)
                             (should (equal file task-file))
                             "todo"))
                          ((symbol-function 'my/task-session-prune-stale)
                           (lambda (&rest _args)
                             (ert-fail "Shared-root resolution should keep the live session active"))))
                  (should (equal (my/task-session-sync-active) (list task-id)))
                  (should (plist-get (gethash task-id my/task-index) :active))))))
        (delete-directory temp-root t)))))

