                                    "skill: task-workflow-v3\n"
                                    "---\n\n"
                                    "## Context\n\n"
                                    "Body text.\n"))))
    (unwind-protect
        (cl-letf (((symbol-function 'my/task-resolve-id)
                   (lambda (_task)
                     "20260324T082727"))
                  ((symbol-function 'my/task-file)
                   (lambda (_task-id)
                     task-file))
                  ((symbol-function 'denote-filetype-heuristics)
                   (lambda (_file)
                     'markdown-yaml))
                  ((symbol-function 'denote-retrieve-front-matter-title-value)
                   (lambda (_file _filetype)
