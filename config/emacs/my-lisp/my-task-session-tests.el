(ert-deftest my/task-session-prepare-work-async-persists-worktree-on-assignment ()
  (provide 'consult)
  (require 'my-task-session)
  (require 'my-worktree-repair)
  (let (recorded-put)
    (cl-letf (((symbol-function 'denote-get-path-by-id)
               (lambda (_task-id)
                 "/tmp/task.md"))
              ((symbol-function 'my/task-note-status)
               (lambda (_task)
                 "todo"))
              ((symbol-function 'my/task-note-owner-repo)
