(ert-deftest my/task-session-queue-title-backfill-populates-transient-worktree-state ()
  (provide 'consult)
  (require 'my-task-session)
  (let ((task-id "20260414T215613")
        recorded-worktree
        notifications)
    (clrhash my/task-session--title-backfill-pending)
    (cl-letf (((symbol-function 'my/git-run-async)
               (lambda (_dir _args &rest plist)
                 (funcall (plist-get plist :on-success)
                          "jamesl-20260414T215613\n" 0)))
              ((symbol-function 'my/task--feature-worktree-p)
               (lambda (_path) t))
              ((symbol-function 'my/task-session--call-repair)
               (lambda (_fn branch)
                 (should (equal branch "jamesl-20260414T215613"))
                 task-id))
              ((symbol-function 'my/task-note-file)
               (lambda (id)
                 (should (equal id task-id))
                 "/tmp/task.md"))
              ((symbol-function 'my/task-note-status)
               (lambda (file)
                 (should (equal file "/tmp/task.md"))
                 "todo"))
              ((symbol-function 'my/task-index-worktree-set)
               (lambda (id worktree &optional _persist)
                 (should (equal id task-id))
                 (setq recorded-worktree worktree)))
              ((symbol-function 'my/task-state-notify)
               (lambda (id source &rest props)
                 (push (list id source props) notifications))))
      (my/task-session--queue-title-backfill "/Users/jamesl/work/brucenunk/home-config/b/")
      (should (equal recorded-worktree
                     "/Users/jamesl/work/brucenunk/home-config/b/"))
      (should (equal (caar notifications) task-id))
      (should-not (gethash "/Users/jamesl/work/brucenunk/home-config/b/"
                           my/task-session--title-backfill-pending)))))

